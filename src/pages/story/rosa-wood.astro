---
// 制作ストーリー ROSA WOODさま。トップの事例・作品集から開く
// 見本＝Claude Design「story-rosawood-design.dc.html」（2026/11/4）。文章は見本のまま。作りはるなやさまのページと同じ
import '../../styles/global.css';
import '../../styles/top.css';
import Reveal from '../../components/Reveal.astro';

const LINE_URL = 'https://lin.ee/w7c1g5d';
const FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdGcS_8XJYBhs24_yeaunYVr7l7Rx1rkVDlO2xls7DfjqSNWQ/viewform';

const body = 'm-0 text-[15px] leading-[2.2] text-bl-body font-light';
const secHead = 'flex gap-6 items-start pt-10 border-t-2 border-bl-blue';
const secNo = 'font-garamond text-[72px] leading-[.85] text-bl-orange';
const secTitle = 'm-0 font-mincho text-[clamp(24px,3vw,32px)] leading-[1.6] font-medium tracking-[.1em]';

const crafts = ['石けん', 'ハンドクリーム', 'バスソルト', '梅シロップ', 'お味噌づくり', 'あずきカイロ', '玉ねぎ麹'];

const gallery = [
  { src: '/images/story-gallery1.jpg', caption: 'ROSA WOODのアロマ' },
  { src: '/images/story-gallery2.jpg', caption: '施術メニュー' },
  { src: '/images/story-gallery3.jpg', caption: '暮らしを楽しむ教室' },
  { src: '/images/story-gallery4.jpg', caption: '季節の手しごと' },
];

const flow = ['知る', '好きになる', '体験する', '安心する', '予約する', 'また会いたくなる'];
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>制作ストーリー｜ROSA WOODさま｜Bloom Link</title>
    <meta
      name="description"
      content="Bloom Linkが、アロマテラピーサロン ROSA WOODさまと進めてきたLINE構築の制作ストーリー。お店らしさや想いを大切にしながら、お客さまとのつながりを育てるLINEをご紹介します。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Noto+Sans+JP:wght@300;400;500;700&family=Shippori+Mincho:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bl-cream text-bl-ink font-notojp antialiased tracking-[.04em]">
    <div class="flex flex-col overflow-x-hidden">
      <!-- ヘッダー（トップと同じメニュー） -->
      <header class="pt-8 px-[clamp(24px,5vw,72px)]">
        <div class="flex justify-between items-center gap-6 flex-wrap pb-5 border-b border-bl-line">
          <a href="/" class="text-[13px] font-medium tracking-[.42em] text-bl-ink no-underline">BLOOM LINK</a>
          <nav class="flex gap-6 md:gap-10 whitespace-nowrap text-xs tracking-[.14em]">
            <a href="/dekiru/" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">できること</a>
            <a href="/#price" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">料金</a>
            <a href="/works/" class="text-bl-orange font-medium no-underline">事例</a>
          </nav>
        </div>
        <a href="/works/#rosawood" class="inline-block mt-5 text-xs tracking-[.12em] text-bl-sub no-underline hover:text-bl-orange transition-colors">← 作品集へ戻る</a>
      </header>

      <!-- ヒーロー -->
      <section class="pt-14 pb-[100px] px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto flex flex-wrap gap-x-[clamp(40px,7vw,96px)] gap-y-14 items-center">
          <div class="flex-[1_1_440px] flex flex-col gap-7">
            <div class="flex flex-wrap gap-x-5 gap-y-2.5 items-baseline">
              <span class="font-garamond italic text-[17px] tracking-[.12em] text-bl-orange">Story</span>
              <span class="text-xs font-medium tracking-[.2em] text-bl-blue">制作ストーリー・アロマテラピーサロン</span>
            </div>
            <h1 class="m-0 font-mincho text-[clamp(36px,5vw,56px)] leading-[1.4] font-medium tracking-[.14em]">ROSA WOOD<span class="text-[.5em] ml-1.5">さま</span></h1>
            <p class="m-0 font-mincho text-lg leading-[2.1] font-medium">Bloom Linkは、「LINEを作ること」を目的にはしていません。<br />そのお店らしさや想いを大切にしながら、<br /><span class="text-bl-orange">お客さまとのつながりを育てていくこと</span>を大切にしています。</p>
            <p class="m-0 text-sm leading-[2.1] text-bl-body font-light">ROSA WOODさまとの取り組みは、その想いを形にしていく、大切なプロジェクトのひとつです。</p>
          </div>
          <div class="flex-[0_0_auto] mx-auto relative">
            <div class="w-[min(340px,calc(100vw-96px))] aspect-[340/450] rounded-t-full bg-bl-orange overflow-hidden flex items-end justify-center">
              <div class="w-[64%] rounded-t-[24px] bg-bl-ink pt-[7px] px-[7px]">
                <img src="/images/works/rosawood-richmenu.jpg" alt="ROSA WOODさまのLINE画面" class="block w-full aspect-[9/15] object-cover object-top rounded-t-[18px] bg-bl-cream" />
              </div>
            </div>
            <span class="absolute -left-[min(32px,5vw)] top-[12%] w-[min(68px,17vw)] aspect-square rounded-full bg-bl-blue"></span>
          </div>
        </div>
        <div class="max-w-[1080px] mx-auto mt-14 flex gap-4 items-start px-6 py-5 bg-bl-card rounded border border-bl-line">
          <span class="shrink-0 text-[11px] font-bold tracking-[.14em] text-white bg-bl-orange px-2.5 py-1 rounded-full">納品済み</span>
          <p class="m-0 text-[13px] leading-[1.9] text-bl-body">※この案件は、2026年9月に納品しました。「どんな想いで、どう考えて作ったか」という制作の過程と、納品のあとの様子をご紹介します。</p>
        </div>
      </section>

      <!-- 01 知る -->
      <section class="py-[120px] px-[clamp(24px,5vw,72px)] bg-bl-cream2">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-12">
          <div class={secHead}><span class={secNo}>01</span><h2 class={secTitle}>まず、じっくり"知る"ことから始めました</h2></div>
          <div class="flex flex-wrap gap-x-16 gap-y-10 items-start">
            <div class="flex-[1_1_420px] flex flex-col gap-[22px]">
              <p class={body}>ご相談をいただいてすぐに提案するのではなく、まずはROSA WOODさまのInstagramやホームページを、時間をかけて拝見しました。</p>
              <p class={body}>Instagramには400人を超えるフォロワーさんがいらっしゃり、ななえさんの日々の暮らしや想いが、ていねいに綴られていました。</p>
              <p class={body}>そして、その世界観に惹かれたファンの方が、すでにたくさんいらっしゃることも感じました。また、ななえさんの魅力は、発信される一つひとつの言葉にも、相手を思いやる優しさがあふれていました。</p>
            </div>
            <div class="flex-[1_1_340px] flex flex-col gap-5">
              <div class="bg-bl-card rounded p-7 flex flex-col gap-4 border-t-[3px] border-bl-blue">
                <p class="m-0 text-sm leading-[2] text-bl-body">アロマを使った石けん・ハンドクリーム・バスソルトなどの手づくり。季節の恵みを楽しむ梅シロップ、お味噌づくり、あずきカイロ、玉ねぎ麹など…。</p>
                <div class="flex flex-wrap gap-2">
                  {crafts.map((c) => <span class="text-xs px-3 py-1.5 rounded-full bg-bl-cream2">{c}</span>)}
                </div>
              </div>
              <p class="m-0 font-mincho text-[17px] leading-[2] font-medium pl-5 border-l-2 border-bl-orange">画面越しからも、<span class="text-bl-orange">「暮らしを大切にされている方なんだな」</span>という温かな空気が伝わってきました。</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 魅力 -->
      <section class="py-[120px] px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-12">
          <div class={secHead}><span class={secNo}>02</span><h2 class={secTitle}>私が感じた<span class="inline-block">ROSA WOODさまの魅力</span></h2></div>
          <div class="flex flex-wrap gap-x-16 gap-y-10 items-center">
            <div class="flex-[1_1_340px] flex flex-col gap-3.5 items-start">
              <span class="font-mincho text-[clamp(24px,3.2vw,34px)] leading-[1.6] font-medium text-bl-orange"><span class="inline-block">「ななえさんに</span><span class="inline-block">会いたい」</span></span>
              <span class="font-mincho text-[clamp(24px,3.2vw,34px)] leading-[1.6] font-medium text-bl-blue pl-[clamp(20px,5vw,64px)]"><span class="inline-block">「ななえさんに</span><span class="inline-block">相談したい」</span></span>
            </div>
            <div class="flex-[1_1_420px] flex flex-col gap-[22px]">
              <p class={body}>発信を拝見する中で、私が一番感じた大きな魅力は、施術だけではなく、ななえさんのお人柄や丁寧な暮らしでした。</p>
              <p class={body}>その温かな世界観に惹かれ、「ななえさんに会いたい」「ななえさんに相談したい」と足を運ぶ方がたくさんいらっしゃることも伝わってきました。</p>
              <p class="m-0 font-mincho text-[17px] leading-[2] font-medium text-bl-ink">この魅力をLINEでも大切につないでいけたら、お客さまとのご縁はさらに深まり、安心して長く通いたくなる場所になっていく。<br />そんな未来を思い描きました。</p>
            </div>
          </div>
        </div>
      </section>

      <!-- STEP2 -->
    </div>
    <Reveal />
  </body>
</html>
