---
// 「できること」のページ（2026/11/3 トップと同じデザインに作り直し）
// デザイン見本：design_handoff_toppage/dekiru-design.dc.html
// 文章は見本のまま。画像は /images/dekiru/ のものを使う。
// 作り直す前のページの控え：sanae claud/★バックアップ/dekiru_20261103_作り直す前.astro
import '../styles/global.css';
import '../styles/top.css';
import Reveal from '../components/Reveal.astro';

const LINE_URL = 'https://lin.ee/w7c1g5d';
const FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdGcS_8XJYBhs24_yeaunYVr7l7Rx1rkVDlO2xls7DfjqSNWQ/viewform';

const jump = [
  { n: '01', label: '予約システム＆お客様一覧', href: '#f1' },
  { n: '02', label: '本日の営業・おすすめ', href: '#f2' },
  { n: '03', label: 'お客さま向けのセルフチェック', href: '#f3' },
  { n: '04', label: 'スマホ秘書', href: '#f4' },
];

const troubles = [
  '予約のDMを、見落としそうになる',
  '「今日やってますか？」に、何度も答えている',
  '常連さんの好みを、頭で覚えておくのが大変',
  '閉店後に、あと30分の事務作業が残る',
];

const yoyakuPoints = [
  '満席になったら、自動で受付を止めます',
  '予約が入ると、お店のLINEにお知らせが届きます',
  'はじめての方には、好きな食べ物や苦手なものをうかがいます',
  '席数や定休日は、スマホからいつでも変えられます',
];

const kokyakuPoints = [
  '来店回数・アンケートの答え・お店のメモを、1人1枚のカードに',
  '名前や電話番号で、すぐに探せます',
  '「今月お誕生日の方」だけを出すこともできます',
];

// 画面は、大事なところだけを大きく見せる（zoom）。さわると、画面の全体（full）が大きく開く（2026/11/4）
const kanriScreens = [
  { src: '/images/dekiru/kanri-yoyaku-zoom.jpg', full: '/images/dekiru/kanri-yoyaku.jpg', alt: 'お店側の画面 予約の一覧', cap: '予約の一覧（今日・明日の組数もひと目で）' },
  { src: '/images/dekiru/kanri-kokyaku-zoom.jpg', full: '/images/dekiru/kanri-kokyaku.jpg', alt: 'お店側の画面 お客様一覧', cap: 'お客様一覧（来た回数・好み・お店のメモ）' },
  { src: '/images/dekiru/kanri-birthday-zoom.jpg', full: '/images/dekiru/kanri-birthday.jpg', alt: 'お店側の画面 今月お誕生日の方', cap: '「今月お誕生日の方」だけを出したところ' },
];

const statusUses = [
  '飲食店なら「本日のおすすめ」「本日のランチ」',
  'サロンなら「本日の出勤スタッフ」「本日の空き時間」',
  'スマホで撮った写真つきにもできます',
];

const checkPoints = [
  '質問はお店に合わせて作ります（5問くらいがおすすめ）',
  '結果のすぐ下に、オーナーさんからのひとことと申し込みボタン',
];

const checkExamples = [
  'カウンセリングなら「心の違和感チェック」',
  'サロンなら「肌タイプチェック」「疲れ度チェック」',
  '習い事なら「向いているコース診断」',
];

const botPoints = [
  '「今日の予定」と送ると、今日のお客さまを一覧で',
  'レシートの写真を送ると、AIが読み取って表に1行ずつ記録',
  'メールで届く領収書も、毎朝自動で保存',
];

const monitorTerms = [
  { k: '管理費', v: '3か月無料（4か月目から月3,000円）' },
  { k: 'AIの利用料', v: '実費（使った分だけ）' },
  { k: 'お願い', v: '月1回、使い心地を教えてください（10分くらい）\n感想を作品集でご紹介させてください' },
  { k: '募集', v: '2026年12月31日まで（3名になりしだい終了）' },
];

// 見出し（01 できること① …）の共通の形
const numCls = 'font-garamond text-[56px] md:text-[72px] leading-[.85]';
const h2Cls = 'm-0 font-mincho text-[clamp(26px,3vw,34px)] leading-[1.6] font-medium tracking-[.1em]';
const leadCls = 'm-0 font-mincho text-[19px] leading-[1.9] font-medium';
const lineList = 'm-0 p-0 list-none flex flex-col border-t border-bl-line';
const lineItem = 'py-3.5 border-b border-bl-line text-sm leading-[1.9] text-bl-body font-light';
const dotItem = 'flex gap-2.5 text-[13px] leading-[1.9] text-bl-body';
const dot = 'w-[5px] h-[5px] rounded-full bg-bl-blue mt-[11px] shrink-0';
const jireiBtn = 'self-start text-[13px] font-bold tracking-[.1em] text-white bg-bl-orange no-underline px-6 py-3.5 rounded-full transition-colors hover:bg-bl-ink';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>できること｜Bloom Link</title>
    <meta
      name="description"
      content="予約システム＆お客様一覧、本日の営業・おすすめ、お客さま向けのセルフチェック、スマホ秘書。オーナーさんの毎日の手間を、LINEで減らします。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Noto+Sans+JP:wght@300;400;500;700&family=Shippori+Mincho:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bl-cream text-bl-ink font-notojp antialiased tracking-[.04em]">
    <div class="flex flex-col overflow-x-hidden">
      <!-- ヘッダー（トップと同じメニュー。「できること」はこのページ） -->
      <header class="pt-8 px-[clamp(24px,5vw,72px)]">
        <div class="flex justify-between items-center gap-6 flex-wrap pb-5 border-b border-bl-line">
          <a href="/" class="text-[13px] font-medium tracking-[.42em] text-bl-ink no-underline">BLOOM LINK</a>
          <nav class="flex gap-6 md:gap-10 whitespace-nowrap text-xs tracking-[.14em]">
            <a href="/dekiru/" aria-current="page" class="text-bl-orange font-medium no-underline">できること</a>
            <a href="/#price" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">料金</a>
            <a href="/#works" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">事例</a>
          </nav>
        </div>
        <a href="/" class="inline-block mt-5 text-xs tracking-[.12em] text-bl-sub no-underline hover:text-bl-orange transition-colors">← トップへ戻る</a>
      </header>

      <!-- 01 ヒーロー -->
      <section class="pt-14 pb-[120px] px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto flex flex-wrap gap-x-[clamp(40px,7vw,96px)] gap-y-14 items-center">
          <div class="flex-[1_1_440px] flex flex-col gap-8">
            <span class="font-garamond italic text-[17px] tracking-[.12em] text-bl-orange">Service</span>
            <h1 class="m-0 font-mincho text-[clamp(30px,4.2vw,46px)] leading-[1.75] font-medium tracking-[.1em]">
              スタッフを増やす前に、<br /><span class="text-bl-orange">LINEにまかせてみる。</span>
            </h1>
            <p class="m-0 text-[15px] leading-[2.2] text-bl-body font-light">
              オーナーさんの毎日の手間を、LINEで減らします。<br />お店ごとに、そのお店だけのしくみを作ります。<br />パソコンを開かず、スマホ一つで解決します。
            </p>
            <nav class="flex flex-wrap gap-2.5">
              {jump.map((j) => (
                <a href={j.href} class="dk-chip flex gap-2 items-baseline text-[13px] font-medium text-bl-ink no-underline border border-[#C9BCA9] rounded-full px-[18px] py-2.5 transition-colors">
                  <span class="font-garamond text-base text-bl-blue">{j.n}</span>{j.label}
                </a>
              ))}
            </nav>
          </div>
          <div class="shrink-0 mx-auto relative">
            <div class="w-[min(360px,calc(100vw-96px))] aspect-[360/480] rounded-t-[999px] bg-bl-orange relative overflow-hidden">
              <img src="/images/top/hand-phone_white.png" alt="Bloom Linkのスマホを持つ手" class="absolute left-1/2 -translate-x-[44%] top-[12.4%] h-[93.1%] max-w-none" />
            </div>
            <span class="absolute -left-[min(36px,5vw)] top-[14%] w-[min(72px,18vw)] aspect-square rounded-full bg-bl-blue"></span>
          </div>
        </div>
      </section>

      <!-- 02 こんな手間 -->
      <section class="py-[120px] px-[clamp(24px,5vw,72px)] bg-bl-cream2">
        <div class="max-w-[1080px] mx-auto flex flex-wrap gap-x-[clamp(48px,8vw,120px)] gap-y-10 items-start">
          <div class="flex-[0_1_320px] flex flex-col gap-4">
            <span class="font-garamond italic text-[17px] tracking-[.12em] text-bl-orange">Problem</span>
            <h2 class="m-0 font-mincho text-[32px] leading-[1.8] font-medium tracking-[.14em]">こんな手間、<br />ありませんか？</h2>
          </div>
          <div class="flex-[1_1_420px] flex flex-col gap-12">
            <ul class="m-0 p-0 list-none flex flex-col border-t border-bl-ink">
              {troubles.map((t, i) => (
                <li class="flex gap-7 items-baseline py-6 border-b border-bl-line2 text-base leading-[1.9] font-light">
                  <span class="font-garamond text-[19px] font-medium text-bl-blue min-w-[24px]">{String(i + 1).padStart(2, '0')}</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
            <p class="m-0 font-mincho text-2xl leading-[1.9] font-medium tracking-[.08em]">
              ひとつでも<span class="inline-block">当てはまったら、</span><br /><span class="text-bl-orange">LINEにまかせられる</span>かもしれません。
            </p>
          </div>
        </div>
      </section>

      <!-- 03 できること① 予約システム＆お客様一覧 -->
      <section id="f1" class="py-24 md:py-[140px] px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-14">
          <div class="flex gap-6 items-start pt-10 border-t-2 border-bl-blue">
            <span class={`${numCls} text-bl-orange`}>01</span>
            <div class="flex flex-col gap-2.5">
              <span class="text-xs font-medium tracking-[.2em] text-bl-blue">できること①</span>
              <h2 class={h2Cls}>予約システム＆お客様一覧</h2>
            </div>
          </div>
          <div class="flex flex-wrap gap-x-16 gap-y-10">
            <div class="flex-[1_1_380px] flex flex-col gap-6">
              <p class={leadCls}>お客さまは、LINEから人数・日にち・時間を選ぶだけ。<br />24時間、お店が閉まっている時間も予約を受け付けます。</p>
              <ul class={lineList}>
                {yoyakuPoints.map((t) => <li class={lineItem}>{t}</li>)}
              </ul>
            </div>
            <div class="flex-[1_1_380px] self-start bg-bl-card rounded p-8 flex flex-col gap-4">
              <h3 class="m-0 font-mincho text-[21px] font-medium tracking-[.08em] text-bl-blue">お客様一覧も、スマホで</h3>
              <p class="m-0 text-sm leading-loose text-bl-body font-light">来てくださったお客さまの情報を、スマホでいつでも見られます。</p>
              <ul class="m-0 p-0 list-none flex flex-col gap-2">
                {kokyakuPoints.map((t) => <li class={dotItem}><span class={dot}></span><span>{t}</span></li>)}
              </ul>
            </div>
          </div>
          <div class="bg-bl-blue rounded px-[clamp(20px,4vw,48px)] pt-[clamp(28px,5vw,56px)] overflow-hidden">
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-x-6 gap-y-7 items-end">
              {kanriScreens.map((s) => (
                <figure class="m-0 flex flex-col gap-3.5 items-center">
                  <figcaption class="text-xs leading-[1.8] text-white text-center">{s.cap}</figcaption>
                  <button type="button" data-zoom={s.full} data-zoom-alt={s.alt} aria-label={`${s.alt}を大きく見る`} class="dk-zoom relative block w-[min(300px,100%)] rounded-t-[26px] bg-bl-ink px-[7px] pt-[7px] border-0 cursor-zoom-in">
                    <img src={s.src} alt={s.alt} width="640" height="940" loading="lazy" class="block w-full aspect-[640/940] object-cover object-top rounded-t-[20px] bg-bl-cream" />
                    <span class="absolute right-3 bottom-3 text-[11px] font-bold tracking-[.08em] text-white bg-bl-ink/80 rounded-full px-3 py-1.5">＋ 全体を見る</span>
                  </button>
                </figure>
              ))}
            </div>
          </div>
          <div class="flex flex-wrap justify-between items-center gap-5">
            <span class="text-[11px] text-bl-sub">※お店側の画面です。お名前・電話番号は架空のものです</span>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
              <p class="m-0 text-sm leading-[1.9]">府中の「るなや」さんで、<br />実際に使っていただいています。</p>
              <a href="/works/#runaya" class={jireiBtn}>実例を見る（るなや）→</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 できること② 本日の営業・おすすめ -->
      <section id="f2" class="py-24 md:py-[140px] px-[clamp(24px,5vw,72px)] bg-bl-cream2">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-14">
          <div class="flex gap-6 items-start pt-10 border-t-2 border-bl-blue">
            <span class={`${numCls} text-bl-orange`}>02</span>
            <div class="flex flex-col gap-2.5">
              <span class="text-xs font-medium tracking-[.2em] text-bl-blue">できること②</span>
              <h2 class={h2Cls}>本日の営業・おすすめを、<br />ボタン1つで</h2>
            </div>
          </div>
          <div class="flex flex-wrap gap-x-16 gap-y-12 items-center">
            <div class="flex-[1_1_360px] flex flex-col gap-6">
              <p class={leadCls}>「営業中」「臨時休業」「満席」を、ボタン1つで切りかえ。</p>
              <p class="m-0 text-sm leading-[2.1] text-bl-body font-light">お客さまはLINEから、いつでも今日の様子を見られます。<br />「今日やってますか？」のお問い合わせが、減るかもしれません。</p>
            </div>
            <div class="flex-[1_1_420px] h-[440px] rounded-t-[999px] bg-bl-orange relative overflow-hidden flex justify-center items-end gap-4 px-5">
              <div class="w-[min(190px,42%)] rounded-t-3xl bg-bl-ink px-1.5 pt-1.5 translate-y-4">
                <img src="/images/dekiru/status-admin.png" alt="本日の営業状況 切りかえ画面（お店側）" loading="lazy" class="block w-full h-[320px] object-cover object-top rounded-t-[18px] bg-bl-cream" />
              </div>
              <div class="w-[min(190px,42%)] rounded-t-3xl bg-bl-ink px-1.5 pt-1.5">
                <img src="/images/dekiru/status-customer.png" alt="本日の営業状況 お客さまが見る画面" loading="lazy" class="block w-full h-[340px] object-cover object-top rounded-t-[18px] bg-bl-cream" />
              </div>
            </div>
          </div>
          <div class="bg-bl-card rounded p-[clamp(24px,4vw,40px)] flex flex-wrap gap-x-12 gap-y-8 items-center">
            <div class="flex-[1_1_300px] flex flex-col gap-4">
              <h3 class="m-0 font-mincho text-[21px] font-medium tracking-[.08em] text-bl-blue">こんな使い方もできます</h3>
              <ul class="m-0 p-0 list-none flex flex-col gap-2">
                {statusUses.map((t) => <li class={dotItem}><span class={dot}></span><span>{t}</span></li>)}
              </ul>
              <a href="/works/#runaya" class={`${jireiBtn} mt-2`}>実例を見る（るなや）→</a>
            </div>
            <div class="flex-[1_1_340px] grid grid-cols-2 gap-4">
              <figure class="m-0 flex flex-col gap-2.5">
                <img src="/images/dekiru/sample-lunch.png" alt="本日のランチ（飲食店向けの見本）" loading="lazy" class="block w-full aspect-[3/4] object-cover object-top rounded-2xl border border-bl-line bg-bl-cream" />
                <figcaption class="text-[11px] text-bl-sub">見本です</figcaption>
              </figure>
              <figure class="m-0 flex flex-col gap-2.5">
                <img src="/images/dekiru/sample-staff.png" alt="本日の出勤スタッフ（サロン向けの見本）" loading="lazy" class="block w-full aspect-[3/4] object-cover object-top rounded-2xl border border-bl-line bg-bl-cream" />
                <figcaption class="text-[11px] text-bl-sub">見本です</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 できること③ お客さま向けのセルフチェック（見本では「違和感レベルチェック」。トップに合わせて名前をそろえた・2026/11/3） -->
      <section id="f3" class="py-24 md:py-[140px] px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-14">
          <div class="flex gap-6 items-start pt-10 border-t-2 border-bl-blue">
            <span class={`${numCls} text-bl-orange`}>03</span>
            <div class="flex flex-col gap-2.5">
              <span class="text-xs font-medium tracking-[.2em] text-bl-blue">できること③</span>
              <h2 class={h2Cls}>お客さま向けのセルフチェック<span class="text-[.6em] text-bl-sub ml-2">（診断・チェックページ）</span></h2>
            </div>
          </div>
          <div class="flex flex-wrap gap-x-16 gap-y-12 items-center">
            <div class="shrink-0 mx-auto flex flex-col gap-3.5 items-center">
              <div class="w-[min(300px,calc(100vw-96px))] aspect-[300/400] rounded-t-[999px] bg-bl-blue flex items-end justify-center overflow-hidden">
                <div class="w-[60%] h-[78%] rounded-t-[22px] bg-bl-ink px-1.5 pt-1.5">
                  <!-- 動いているところ：LINEからチェックを開いて、5問に答えて、結果が出るまで（2026/11/4。音なし・くり返し） -->
                  <video
                    src="/images/dekiru/check-yugon-flow.mp4"
                    poster="/images/dekiru/check-yugon-flow-poster.jpg"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-label="ゆうごんさんの違和感レベルチェックに答えて、結果が出るまで（動画）"
                    class="block w-full h-full object-cover object-top rounded-t-2xl bg-[#F9F8F4]"
                  ></video>
                </div>
              </div>
              <span class="text-xs text-bl-sub">夫婦円満カウンセラー ゆうごんさんのチェック</span>
            </div>
            <div class="flex-[1_1_400px] flex flex-col gap-6">
              <p class={leadCls}>いくつかの質問に答えると、点数と結果が出るページです。</p>
              <p class="m-0 text-sm leading-[2.1] text-bl-body font-light">「自分は今どのくらい？」がわかると、<br />お客さまが相談するきっかけになります。</p>
              <ul class={lineList}>
                {checkPoints.map((t) => <li class={lineItem}>{t}</li>)}
              </ul>
              <div class="flex flex-col gap-3">
                <span class="text-xs font-medium tracking-[.12em] text-bl-blue">業種に合わせて、たとえば</span>
                <div class="flex flex-wrap gap-2">
                  {checkExamples.map((t) => <span class="text-xs px-3.5 py-2 rounded-full bg-bl-card border border-bl-line">{t}</span>)}
                </div>
              </div>
              <a href="/works/#yugon" class={jireiBtn}>実例を見る（ゆうごんさん）→</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 06 できること④ スマホ秘書 -->
      <section id="f4" class="py-24 md:py-[140px] px-[clamp(24px,5vw,72px)] bg-bl-blue text-white relative overflow-hidden">
        <span class="absolute -right-[90px] -top-[90px] w-[260px] h-[260px] rounded-full bg-bl-orange"></span>
        <div class="max-w-[1080px] mx-auto flex flex-col gap-14 relative">
          <div class="flex gap-6 items-start pt-10 border-t-2 border-white">
            <span class={`${numCls} text-white`}>04</span>
            <div class="flex flex-col gap-2.5">
              <span class="text-xs font-medium tracking-[.2em] text-[#FBE3D9]">できること④</span>
              <h2 class={h2Cls}>スマホ秘書<span class="inline-block ml-3.5 align-middle font-notojp text-[13px] font-bold tracking-[.14em] bg-bl-orange text-white px-3.5 py-1.5 rounded-full">モニター募集中</span></h2>
            </div>
          </div>
          <div class="flex flex-wrap gap-x-16 gap-y-12 items-center">
            <div class="flex-[1_1_420px] flex flex-col gap-6">
              <p class={leadCls}>LINEで「明日 15時 カット 山田様」と送るだけで、カレンダーに予定が入ります。</p>
              <p class="m-0 text-sm leading-[2.1] font-light">前の日の夜と当日の朝にお知らせが届くので、うっかりを防げます。</p>
              <ul class="m-0 p-0 list-none flex flex-col border-t border-white/35">
                {botPoints.map((t) => <li class="py-3.5 border-b border-white/35 text-sm leading-[1.9] font-light">{t}</li>)}
              </ul>
