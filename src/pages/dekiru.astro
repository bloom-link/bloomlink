---
import '../styles/global.css';
import PhoneFrame from '../components/PhoneFrame.astro';

const LINE_URL = 'https://lin.ee/w7c1g5d';
const FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdGcS_8XJYBhs24_yeaunYVr7l7Rx1rkVDlO2xls7DfjqSNWQ/viewform';

// トップページと同じヘッダーナビ（「できること」だけこのページを指す）
const nav = [
  { label: 'Bloom Linkとは', href: '/#about' },
  { label: 'できること', href: '/dekiru/' },
  { label: '選ばれる理由', href: '/#reason' },
  { label: '料金プラン', href: '/#price' },
  { label: '制作事例', href: '/#works' },
  { label: '作品集', href: '/works/' },
  { label: 'お問い合わせ', href: '/#contact' },
];

const troubles = [
  '予約のDMを、見落としそうになる',
  '「今日やってますか？」に、何度も答えている',
  '常連さんの好みを、頭で覚えておくのが大変',
  '閉店後に、あと30分の事務作業が残る',
];

const yoyakuPoints = [
  '満席になったら、自動で受付を止めます',
  '予約が入ると、お店のLINEにお知らせが届きます',
  'はじめての方には、好きな食べ物や苦手なものをうかがいます',
  '席数や定休日は、スマホからいつでも変えられます',
];

const kokyakuPoints = [
  '来店回数・アンケートの答え・お店のメモを、1人1枚のカードに',
  '名前や電話番号で、すぐに探せます',
  '「今月お誕生日の方」だけを出すこともできます',
];

const otherUses = [
  '飲食店なら「本日のおすすめ」「本日のランチ」',
  'サロンなら「本日の出勤スタッフ」「本日の空き時間」',
  'スマホで撮った写真つきにもできます',
];

const checkUses = [
  'カウンセリングなら「心の違和感チェック」',
  'サロンなら「肌タイプチェック」「疲れ度チェック」',
  '習い事なら「向いているコース診断」',
];

const botPoints = [
  '「今日の予定」と送ると、今日のお客さまを一覧で',
  'レシートの写真を送ると、AIが読み取って表に1行ずつ記録',
  'メールで届く領収書も、毎朝自動で保存',
];

const monitorTerms = [
  { k: '料金', v: '1機能 10,000円（通常50,000円〜）\n予定の秘書か、領収書の秘書のどちらか1つ' },
  { k: '管理費', v: '3か月無料（4か月目から月3,000円）' },
  { k: 'AIの利用料', v: '実費（使った分だけ）' },
  { k: 'お願い', v: '月1回、使い心地を教えてください（10分くらい）\n感想を作品集でご紹介させてください' },
  { k: '募集', v: '2026年12月31日まで（3名になりしだい終了）' },
];

// 見出しの上の小さなラベル（できること①など）
// ピンクの帯ラベルでメリハリをつける（作品集の店名の帯と同じ色）
const label = 'inline-block text-xs md:text-sm tracking-[0.2em] text-white rounded-full px-5 py-1.5 mb-4 bg-gradient-to-b from-[#e7aeb8] to-[#DFA2AE] shadow-[inset_0_1px_0_rgba(255,255,255,0.35)]';
const h2 = 'text-xl md:text-[1.7rem] font-medium text-sage leading-snug';
const body = 'ja-text text-[#5c5450] leading-[2]';
const caption = 'text-xs text-[#6B6B64] text-center mt-4';
const dot = 'mt-[0.85em] h-1.5 w-1.5 shrink-0 rounded-full bg-[#DFA2AE]';
const jireiLink = 'text-sm text-sage underline underline-offset-4 decoration-sage/30 hover:decoration-sage transition-colors';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>できること｜Bloom Link</title>
    <meta
      name="description"
      content="スタッフを増やす前に、LINEにまかせてみる。予約システム＆お客様一覧、本日の営業、違和感レベルチェック、スマホ秘書など、Bloom Linkが作れるLINEのしくみをご紹介します。"
    />
  </head>
  <body class="bg-cream text-[#3f3a37] font-sans antialiased">
    <!-- ヘッダー（トップページと同じ） -->
    <header class="sticky top-0 z-50 bg-cream/90 backdrop-blur border-b border-sage/10">
      <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
        <a href="/" class="text-lg tracking-widest text-sage font-semibold">Bloom Link</a>
        <nav class="hidden md:flex items-center gap-8 text-sm text-[#5c5450]">
          {nav.map((item) => (
            <a href={item.href} class="hover:text-sage transition-colors">{item.label}</a>
          ))}
        </nav>
        <a
          href="/#contact"
          class="text-xs md:text-sm text-white rounded-full px-5 py-2 bg-gradient-to-b from-[#e2aab6] to-[#cf8b98] shadow-[inset_0_1px_0_rgba(255,255,255,0.3),0_6px_16px_rgba(180,120,132,0.18)] hover:from-[#d99aa8] hover:to-[#bf7a89] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_8px_20px_rgba(180,120,132,0.24)] hover:-translate-y-0.5 transition-all duration-200 whitespace-nowrap"
        >
          無料相談してみる
        </a>
      </div>
    </header>

    <main>
      <!-- ■ 1. いちばん上 -->
      <section class="bg-cream bg-[radial-gradient(ellipse_at_85%_20%,rgba(232,184,190,0.28),transparent_55%)]">
        <div class="max-w-5xl mx-auto px-6 pt-8 md:pt-10 pb-14 md:pb-20">
          <a href="/" class="inline-block text-xs text-[#6B6B64] hover:text-sage transition-colors mb-14 md:mb-20">← トップへ戻る</a>
          <p class="text-xs tracking-[0.25em] text-sage/60 mb-4">SERVICE</p>
          <h1 class="ja-text text-2xl md:text-[2rem] font-medium text-sage leading-[1.6] mb-8">
            スタッフを増やす前に、<br class="md:hidden" />LINEにまかせてみる。
          </h1>
          <p class={`${body} max-w-3xl`}>
            オーナーさんの毎日の手間を、LINEで減らします。<br />
            お店ごとに、そのお店だけのしくみを作ります。<br />
            パソコンを開かず、スマホ一つで解決します。
          </p>
        </div>
      </section>

      <!-- ■ 2. こんな手間、ありませんか？ -->
      <section class="bg-[#BFD4C7]/20">
        <div class="max-w-3xl mx-auto px-6 py-16 md:py-24">
          <h2 class={`${h2} mb-10 text-center`}>こんな手間、ありませんか？</h2>
          <ul class="bg-white/70 rounded-2xl px-6 md:px-10 py-6 md:py-8 space-y-4 shadow-[0_8px_24px_rgba(53,94,72,0.06)]">
            {troubles.map((t) => (
              <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]">
                <span aria-hidden="true" class="mt-[0.45em] h-4 w-4 shrink-0 rounded-[4px] border border-[#DFA2AE] bg-[#E8B8BE]/15"></span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
          <p class={`${body} text-center mt-10`}>
            ひとつでも当てはまったら、<br class="md:hidden" />LINEにまかせられるかもしれません。
          </p>
        </div>
      </section>

      <!-- ■ 3. できること① 予約システム＆お客様一覧 -->
      <section class="bg-cream">
        <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
          <div class="grid gap-12 md:grid-cols-[1fr_300px] md:gap-16 md:items-center">
            <div>
              <p class={label}>できること①</p>
              <h2 class={`${h2} mb-8`}>予約システム＆お客様一覧</h2>
              <p class={`${body} mb-8`}>
                お客さまは、LINEから人数・日にち・時間を選ぶだけ。<br />
                24時間、お店が閉まっている時間も予約を受け付けます。
              </p>
              <ul class="space-y-3">
                {yoyakuPoints.map((p) => (
                  <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]">
                    <span aria-hidden="true" class={dot}></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <PhoneFrame class="max-w-[280px] md:max-w-[300px] md:row-start-1 md:col-start-2">
              <video
                src="/images/dekiru/yoyaku-flow.mp4"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                aria-label="LINEから予約する流れ（動画）"
              ></video>
            </PhoneFrame>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-8 mt-20 md:mt-24 max-w-[900px] mx-auto">
            <figure>
              <PhoneFrame class="max-w-[260px]">
                <img src="/images/dekiru/kanri-yoyaku.jpg" alt="お店側の画面 予約の一覧" loading="lazy" />
              </PhoneFrame>
              <figcaption class={caption}>予約の一覧（今日・明日の組数もひと目で）</figcaption>
            </figure>
            <figure>
              <PhoneFrame class="max-w-[260px]">
                <img src="/images/dekiru/kanri-kokyaku.jpg" alt="お店側の画面 お客様一覧" loading="lazy" />
              </PhoneFrame>
              <figcaption class={caption}>お客様一覧（来た回数・好み・お店のメモ）</figcaption>
            </figure>
            <figure>
              <PhoneFrame class="max-w-[260px]">
                <img src="/images/dekiru/kanri-birthday.jpg" alt="お店側の画面 今月お誕生日の方" loading="lazy" />
              </PhoneFrame>
              <figcaption class={caption}>「今月お誕生日の方」だけを出したところ</figcaption>
            </figure>
          </div>
          <p class="text-xs text-[#6B6B64] text-center mt-6">※お店側の画面です。お名前・電話番号は架空のものです</p>

          <div class="max-w-[620px] mx-auto mt-16 md:mt-20 rounded-2xl bg-white/70 border border-sage/10 px-6 md:px-10 py-6 md:py-8">
            <h3 class="text-base md:text-lg font-medium text-sage mb-3">お客様一覧も、スマホで</h3>
            <p class={`${body} mb-5`}>来てくださったお客さまの情報を、スマホでいつでも見られます。</p>
            <ul class="space-y-3">
              {kokyakuPoints.map((p) => (
                <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]">
                  <span aria-hidden="true" class={dot}></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="ja-text text-center text-sage font-medium leading-[1.9] mt-14 md:mt-16">
            府中の「るなや」さんで、<br class="md:hidden" />実際に使っていただいています。
          </p>
          <p class="text-center mt-4"><a href="/works/#runaya" class={jireiLink}>実例を見る（るなや）→</a></p>
        </div>
      </section>

      <!-- ■ 4. できること② 本日の営業（おすすめ） -->
      <section class="bg-[#E8B8BE]/[0.14]">
        <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
          <div class="max-w-3xl mb-14 md:mb-16">
            <p class={label}>できること②</p>
            <h2 class={h2}>本日の営業・おすすめを、<br class="md:hidden" />ボタン1つで</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-12 max-w-[620px] mx-auto">
            <PhoneFrame class="max-w-[260px]">
              <img src="/images/dekiru/status-admin.png" alt="本日の営業状況 切りかえ画面（お店側）" loading="lazy" />
            </PhoneFrame>
            <PhoneFrame class="max-w-[260px]">
              <img src="/images/dekiru/status-customer.png" alt="本日の営業状況 お客さまが見る画面" loading="lazy" />
            </PhoneFrame>
          </div>

          <p class={`${body} max-w-3xl mx-auto md:text-center mt-14 md:mt-16`}>
            「営業中」「臨時休業」「満席」を、ボタン1つで切りかえ。<br />
            お客さまはLINEから、いつでも今日の様子を見られます。<br />
            「今日やってますか？」のお問い合わせが、減るかもしれません。
          </p>

          <div class="mt-20 md:mt-24 pt-14 md:pt-16 border-t border-sage/10">
            <h3 class="text-base md:text-lg font-medium text-sage text-center mb-12">こんな使い方もできます</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-12 max-w-[620px] mx-auto">
              <figure>
                <PhoneFrame class="max-w-[260px]">
                  <img src="/images/dekiru/sample-lunch.png" alt="本日のランチ（飲食店向けの見本）" loading="lazy" />
                </PhoneFrame>
                <figcaption class={caption}>見本です</figcaption>
              </figure>
              <figure>
                <PhoneFrame class="max-w-[260px]">
                  <img src="/images/dekiru/sample-staff.png" alt="本日の出勤スタッフ（サロン向けの見本）" loading="lazy" />
                </PhoneFrame>
                <figcaption class={caption}>見本です</figcaption>
              </figure>
            </div>

            <ul class="space-y-3 mt-12 w-fit mx-auto">
              {otherUses.map((u) => (
                <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]">
                  <span aria-hidden="true" class={dot}></span>
                  <span>{u}</span>
                </li>
              ))}
            </ul>
            <p class="text-center mt-10"><a href="/works/#runaya" class={jireiLink}>実例を見る（るなや）→</a></p>
          </div>
        </div>
      </section>

      <!-- ■ 5. できること③ 違和感レベルチェック（診断・チェックページ） -->
      <section class="bg-cream">
        <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
          <div class="grid gap-12 md:grid-cols-[1fr_300px] md:gap-16 md:items-center">
            <div>
              <p class={label}>できること③</p>
              <h2 class={`${h2} mb-8`}>違和感レベルチェック<br /><span class="text-base md:text-lg">（診断・チェックページ）</span></h2>
              <p class={`${body} mb-8`}>
                いくつかの質問に答えると、点数と結果が出るページです。<br />
                「自分は今どのくらい？」がわかると、<br class="md:hidden" />お客さまが相談するきっかけになります。
              </p>
              <ul class="space-y-3 mb-8">
                <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]"><span aria-hidden="true" class={dot}></span><span>質問はお店に合わせて作ります（5問くらいがおすすめ）</span></li>
                <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]"><span aria-hidden="true" class={dot}></span><span>結果のすぐ下に、オーナーさんからのひとことと申し込みボタン</span></li>
              </ul>
              <div class="rounded-2xl bg-white/70 border border-[#E8B8BE]/50 px-6 py-5">
                <p class="text-sm font-medium text-sage mb-3">業種に合わせて、たとえば</p>
                <ul class="space-y-2">
                  {checkUses.map((u) => (
                    <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]">
                      <span aria-hidden="true" class={dot}></span>
                      <span>{u}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <figure class="w-full md:row-start-1 md:col-start-2">
              <PhoneFrame class="max-w-[280px] md:max-w-[300px]">
                <video
                  src="/images/dekiru/check-flow.mp4"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="違和感レベルチェックに答えて結果が出るまで（動画）"
                ></video>
              </PhoneFrame>
              <figcaption class={caption}>夫婦円満カウンセラー ゆうごんさんのチェック</figcaption>
            </figure>
          </div>
          <p class="text-center mt-14"><a href="/works/#yugon" class={jireiLink}>実例を見る（ゆうごんさん）→</a></p>
        </div>
      </section>

      <!-- ■ 6. できること④ スマホ秘書（モニター募集中） -->
      <section class="bg-[#BFD4C7]/20">
        <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
          <div class="grid gap-12 md:grid-cols-[1fr_300px] md:gap-16 md:items-center">
            <div>
              <p class={label}>できること④</p>
              <h2 class={`${h2} mb-8`}>
                スマホ秘書<span class="ml-2 align-middle inline-block text-xs font-normal text-[#c98593] bg-[#E8B8BE]/25 rounded-full px-3 py-0.5">モニター募集中</span>
              </h2>
              <p class={`${body} mb-8`}>
                LINEで「明日 15時 カット 山田様」と送るだけで、カレンダーに予定が入ります。<br />
                前の日の夜と当日の朝にお知らせが届くので、うっかりを防げます。
              </p>
              <ul class="space-y-3 mb-8">
                {botPoints.map((b) => (
                  <li class="flex gap-3 ja-text text-[#5c5450] leading-[1.9]">
                    <span aria-hidden="true" class={dot}></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <p class="ja-text text-sm text-[#6B6B64] leading-[1.9]">
                請求書の整理・発行、各店舗の売り上げ管理なども作れます。<br />
                Bloom Linkも、毎日この秘書を使っています。
              </p>
            </div>
            <PhoneFrame class="max-w-[280px] md:max-w-[300px] md:row-start-1 md:col-start-2">
              <img src="/images/dekiru/bot-salon.png" alt="スマホ秘書 サロン向けのイメージ" loading="lazy" />
            </PhoneFrame>
          </div>

          <div class="max-w-[620px] mx-auto mt-16 md:mt-20 rounded-2xl bg-white/80 border border-[#E8B8BE]/50 px-6 md:px-10 py-7 md:py-9">
            <h3 class="text-base md:text-lg font-medium text-sage mb-2">モニターを募集しています（先着3名）</h3>
            <p class={`${body} mb-6`}>使い心地や改善点を一緒に教えていただける方に、特別価格でお作りします。</p>
            <dl class="divide-y divide-sage/10">
              {monitorTerms.map((t) => (
                <div class="grid grid-cols-[6.5em_1fr] gap-3 py-3">
                  <dt class="text-sm text-sage font-medium leading-[1.9]">{t.k}</dt>
                  <dd class="ja-text text-sm text-[#5c5450] leading-[1.9] whitespace-pre-line">{t.v}</dd>
                </div>
              ))}
            </dl>
            <p class="text-xs text-[#6B6B64] mt-4">※金額はすべて税別です</p>
          </div>
        </div>
      </section>

      <!-- ■ 7. さいごに -->
      <section class="bg-[#E8B8BE]/[0.14]">
        <div class="max-w-3xl mx-auto px-6 py-20 md:py-28 text-center">
          <h2 class={`${h2} mb-6`}>「うちのお店だと、何ができる？」</h2>
          <p class={`${body} mb-10`}>
            それを一緒に考えるのが、無料相談です。<br />
            無理におすすめすることはありません。
          </p>
          <a
            href={FORM_URL}
            target="_blank"
            rel="noopener"
            class="inline-block w-full max-w-xs md:w-auto text-white rounded-full px-10 py-4 text-sm font-medium bg-gradient-to-b from-[#e2aab6] to-[#cf8b98] shadow-[inset_0_1px_0_rgba(255,255,255,0.3),0_8px_22px_rgba(180,120,132,0.24)] hover:from-[#d99aa8] hover:to-[#bf7a89] hover:-translate-y-0.5 transition-all duration-200"
          >
            まずは無料で相談してみる
          </a>
          <p class="mt-7 flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8">
            <a href="/works/" class={jireiLink}>作品集・実例を見る</a>
            <a href="/#price" class={jireiLink}>サービス・料金を見る</a>
          </p>
          <p class="mt-14">
            <a href="/" class="text-xs text-[#6B6B64] hover:text-sage transition-colors">← トップへ戻る</a>
          </p>
        </div>
      </section>
    </main>

    <!-- フッター（トップページと同じ） -->
    <footer class="bg-sage text-cream">
      <div class="max-w-6xl mx-auto px-6 py-14 md:py-16 text-center">
        <p class="text-xl tracking-[0.15em] mb-7">Bloom Link</p>
        <p class="mb-6 text-2xl md:text-3xl leading-relaxed">
          つながりを育て、<br />
          未来を咲かせる。
        </p>
        <p class="mb-10 text-sm text-cream/85 max-w-xs md:max-w-sm mx-auto leading-relaxed">
          LINE公式の構築から運用まで、<br class="hidden md:block" />
          お気軽にご相談ください。
        </p>
        <div class="flex flex-col md:flex-row items-center justify-center gap-4">
          <a
            href="https://docs.google.com/forms/d/e/1FAIpQLSdGcS_8XJYBhs24_yeaunYVr7l7Rx1rkVDlO2xls7DfjqSNWQ/viewform"
            target="_blank"
            rel="noopener"
