<script>
  // できること①の画面：さわると全体を大きく表示。背景・×・Escキーで閉じる
  const zbox = document.querySelector<HTMLElement>('[data-zoom-box]');
  const zimg = document.querySelector<HTMLImageElement>('[data-zoom-img]');
  if (zbox && zimg) {
    const close = () => { zbox.hidden = true; document.body.style.overflow = ''; };
    document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        zimg.src = b.dataset.zoom ?? '';
        zimg.alt = b.dataset.zoomAlt ?? '';
        zbox.hidden = false;
        document.body.style.overflow = 'hidden';
      }),
    );
    zbox.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !zbox.hidden) close(); });
  }
</script>

