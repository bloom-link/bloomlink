---
// 作品集のページ（2026/11/3 トップと同じデザインに作り直し）
// デザイン見本：design_handoff_toppage/works-design.dc.html
// 文章は見本のまま。画像は /images/works/ などの今あるものを使う。
// 各事例の場所（#rosawood #runaya #yugon #daijobu #bloomlink）は前のページと同じ
// 作り直す前のページの控え：sanae claud/★バックアップ/works_20261103_作り直す前.astro
import '../styles/global.css';
import '../styles/top.css';

const LINE_URL = 'https://lin.ee/w7c1g5d';
const FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdGcS_8XJYBhs24_yeaunYVr7l7Rx1rkVDlO2xls7DfjqSNWQ/viewform';

const index = [
  { n: '01', id: 'rosawood', name: 'ROSA WOOD', sub: 'アロマテラピーサロン・約3か月 ↓' },
  { n: '02', id: 'runaya', name: 'るなや', sub: '飲食店（東京・府中）・約3か月 ↓' },
  { n: '03', id: 'yugon', name: 'ゆうごんさん', sub: '夫婦円満カウンセラー・約3週間 ↓' },
  { n: '04', id: 'daijobu', name: 'ダイ・JO部', sub: '府中の個人事業主の集まり・約1週間 ↓' },
  { n: '05', id: 'bloomlink', name: 'Bloom Link（自社）', sub: 'LINE公式アカウント・Lステップ構築サポート ↓' },
];

const glossary = [
  { t: 'リッチメニュー', d: 'LINEを開いたとき、画面の下半分にいつも出ているメニュー' },
  { t: 'カードタイプメッセージ', d: 'トークに届く、横にスワイプして見られるカード' },
  { t: 'リッチメッセージ', d: 'トークに届く、1枚の大きな画像' },
];

// CASE 01〜03（困っていたこと／作ったもの／いただいた声 ＋ 横にすべらせて見る画像）
type Case = {
  id: string;
  n: string;
  label: string;
  name: string;
  lead: string;
  problem: string;
  made: string[];
  voice?: { lines: string[]; from: string };
  period: string;
  gallery: { src: string; cap: string }[];
  alt: boolean; // 背景を濃いクリームにする事例
};

const cases: Case[] = [
  {
    id: 'rosawood',
    n: '01',
    label: 'CASE 01・アロマテラピーサロン',
    name: 'ROSA WOOD',
    lead: 'アロマの施術と、暮らしを楽しむ教室をしているサロンです。',
    problem: 'LINEを「予約を取るだけの場所」にしたくない。オーナーさんの人柄や暮らしを知ってもらい、ファンになってもらいたい。',
    made: ['リッチメニュー6区画（アロマってなに？／暮らし／施術メニュー／お客様の声・Q&A／教室／ご予約）', 'めくって読めるカード16枚', '施術メニューのページ'],
    voice: { lines: ['「予約を初めてスマホからできました」', '「綺麗になった」'], from: '— お客さまより' },
    period: '期間：約3か月（2026年6月〜9月）',
    gallery: [
      { src: '/images/works/rosawood-message.jpg', cap: 'リッチメッセージ（トークに届く読みもの）' },
      { src: '/images/works/rosawood-richmenu.jpg', cap: 'リッチメニュー' },
      { src: '/images/works/rosawood-card-aroma.jpg', cap: 'ROSA WOODのアロマ' },
      { src: '/images/works/rosawood-card-voice.jpg', cap: 'お客様の声' },
    ],
    alt: false,
  },
  {
    id: 'runaya',
    n: '02',
    label: 'CASE 02・飲食店（東京・府中）',
    name: 'るなや',
    lead: '毎日日替わりのおうちご飯とお酒のお店です（17席・おひとりで営業）。',
    problem: '予約がDM・電話・口頭でばらばらに入り、見落としそうになる。「今日やってますか？」の問い合わせにも、営業中に答えていた。',
    made: ['お店専用の予約システム：満席で自動停止／お店のLINEにお知らせ／お客さまに予約の控え', 'お客様一覧（来店回数・アンケート・お店のメモ）', '本日の営業状況（ボタン1つで切りかえ）', '「るなやとは」ページ・ポイントカード'],
    voice: { lines: ['「使いやすい」'], from: '— オーナーさんより' },
    period: '期間：約3か月（2026年7月〜10月）',
    gallery: [
      { src: '/images/works/phone-runaya.jpg', cap: 'LINE画面' },
      { src: '/images/runaya-richmenu-2026-10.webp', cap: 'リッチメニュー' },
      { src: '/images/runaya-card-hours-2026-10.webp', cap: '営業時間' },
      { src: '/images/runaya-card-point-2026-10.webp', cap: 'ポイントカード' },
      { src: '/images/runaya-eigyo-2026-10.png', cap: '本日の営業状況（実際の画面）' },
    ],
    alt: true,
  },
  {
    id: 'yugon',
    n: '03',
    label: 'CASE 03・夫婦円満カウンセラー',
    name: 'ゆうごんさん',
    lead: '生まれた日から本来の自分を読み解く、夫婦のためのカウンセリングです。',
    problem: 'いきなり「相談しませんか？」では、申し込みのハードルが高い。まず気軽に、自分の今の状態に気づいてもらう入り口がほしい。',
    made: ['LINE公式アカウントのリニューアル（リッチメニュー4区画）', '違和感レベルチェック（5問に答えると点数とレベルが出る）', 'プロフィール・ご相談の流れのページ'],
    period: '期間：約3週間（2026年9月）',
    gallery: [
      { src: '/images/works/phone-yugon.jpg', cap: 'LINE画面' },
      { src: '/images/works/yugon-richmenu.jpg', cap: 'リッチメニュー' },
      { src: '/images/works/yugon-check.jpg', cap: '違和感レベルチェック' },
    ],
    alt: false,
  },
];

const label17 = 'font-garamond italic text-[17px] tracking-[.12em] text-bl-orange';
const h2Cls = 'm-0 font-mincho text-[28px] md:text-[32px] font-medium tracking-[.14em]';
const dotItem = 'flex gap-2.5 text-[13px] leading-[1.9] text-bl-body';
const dot = 'w-[5px] h-[5px] rounded-full bg-bl-blue mt-[11px] shrink-0';
const tallImg = 'block w-full aspect-[3/4] object-cover object-top rounded';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>作品集｜Bloom Link</title>
    <meta
      name="description"
      content="これまでにつくった LINE公式アカウントと、お店専用のしくみです。ROSA WOOD、るなや、ゆうごんさん、ダイ・JO部、Bloom Link（自社）。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Noto+Sans+JP:wght@300;400;500;700&family=Shippori+Mincho:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bl-cream text-bl-ink font-notojp antialiased tracking-[.04em]">
    <div class="flex flex-col overflow-x-hidden">
      <!-- ヘッダー（トップと同じメニュー。「事例」はこのページ） -->
      <header class="pt-8 px-[clamp(24px,5vw,72px)]">
        <div class="flex justify-between items-center gap-6 flex-wrap pb-5 border-b border-bl-line">
          <a href="/" class="text-[13px] font-medium tracking-[.42em] text-bl-ink no-underline">BLOOM LINK</a>
          <nav class="flex gap-6 md:gap-10 whitespace-nowrap text-xs tracking-[.14em]">
            <a href="/dekiru/" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">できること</a>
            <a href="/#price" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">料金</a>
            <a href="/works/" aria-current="page" class="text-bl-orange font-medium no-underline">事例</a>
          </nav>
        </div>
        <a href="/" class="inline-block mt-5 text-xs tracking-[.12em] text-bl-sub no-underline hover:text-bl-orange transition-colors">← トップへ戻る</a>
      </header>

      <!-- 01 ヒーロー -->
      <section class="pt-14 pb-[100px] px-[clamp(24px,5vw,72px)] relative">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-12">
          <div class="flex flex-wrap gap-x-20 gap-y-10 items-end justify-between">
            <div class="flex-[1_1_420px] flex flex-col gap-7">
              <span class={label17}>Works</span>
              <h1 class="m-0 font-mincho text-[clamp(34px,4.6vw,52px)] leading-[1.5] font-medium tracking-[.14em]">作品集</h1>
              <p class="m-0 text-[15px] leading-[2.2] text-bl-body font-light">
                これまでにつくった LINE公式アカウントと、お店専用のしくみです。<br />どれも「そのお店の困りごと」から考えて、一つひとつ作っています。
              </p>
            </div>
            <div class="shrink-0 relative w-[min(220px,50vw)] aspect-[220/290] mr-[min(24px,4vw)]">
              <div class="absolute inset-0 rounded-t-[999px] bg-bl-orange"></div>
              <span class="absolute -right-[min(28px,5vw)] -top-3.5 w-[min(64px,16vw)] aspect-square rounded-full bg-bl-blue"></span>
              <span class="absolute left-1/2 bottom-6 -translate-x-1/2 font-garamond text-[64px] leading-none text-white">05</span>
              <span class="absolute inset-x-0 bottom-2 text-center text-[11px] tracking-[.2em] text-white">cases</span>
            </div>
          </div>
          <nav class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,190px),1fr))] border-t border-bl-ink">
            {index.map((c) => (
              <a href={`#${c.id}`} class="flex flex-col gap-1.5 py-5 pr-4 border-b border-bl-line2 no-underline text-bl-ink transition-colors hover:text-bl-orange">
                <span class="font-garamond text-xl text-bl-blue">{c.n}</span>
                <span class="font-mincho text-[17px] font-medium">{c.name}</span>
                <span class="text-[11px] text-bl-sub leading-[1.7]">{c.sub}</span>
              </a>
            ))}
          </nav>
        </div>
      </section>

      <!-- 02 ことばのミニ辞典 -->
      <section class="pb-[100px] px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto bg-bl-blue text-white rounded p-[clamp(28px,4vw,44px)] flex flex-wrap gap-x-12 gap-y-6 items-start">
          <div class="flex-[0_0_160px] flex flex-col gap-1.5">
            <span class="font-garamond italic text-[15px] text-[#FBE3D9]">Glossary</span>
            <span class="font-mincho text-xl font-medium tracking-[.1em]">ことばのミニ辞典</span>
          </div>
          <dl class="flex-[1_1_480px] m-0 grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-x-8 gap-y-5">
            {glossary.map((g) => (
              <div class="flex flex-col gap-1.5 pt-3.5 border-t border-white/40">
                <dt class="text-sm font-bold">{g.t}</dt>
                <dd class="m-0 text-[13px] leading-[1.9] font-light">{g.d}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- 03 制作事例 見出し -->
      <section class="pt-10 px-[clamp(24px,5vw,72px)]">
        <div class="max-w-[1080px] mx-auto flex flex-wrap justify-between items-end gap-5">
          <div class="flex flex-col gap-3">
            <span class={label17}>Case studies</span>
            <h2 class={h2Cls}>制作事例</h2>
            <p class="m-0 text-sm text-bl-body font-light">実際のお店で使われているLINEです</p>
          </div>
          <a href="/dekiru/" class="text-[13px] font-medium tracking-[.12em] text-bl-blue no-underline border-b border-bl-blue pb-1 hover:text-bl-orange hover:border-bl-orange transition-colors">できることを見る →</a>
        </div>
      </section>

      <!-- CASE 01〜03 -->
      {cases.map((c, i) => (
        <section
          id={c.id}
          class:list={[
            'px-[clamp(24px,5vw,72px)] scroll-mt-6',
            i === 0 ? 'pt-20 pb-[120px]' : 'py-[120px]',
            c.alt && 'bg-bl-cream2',
          ]}
        >
          <div class="max-w-[1080px] mx-auto flex flex-col gap-12">
            <div class="flex gap-6 items-start pt-10 border-t-2 border-bl-blue">
              <span class="font-garamond text-[56px] md:text-[72px] leading-[.85] text-bl-orange">{c.n}</span>
              <div class="flex flex-col gap-2.5">
                <span class="text-xs font-medium tracking-[.2em] text-bl-blue">{c.label}</span>
                <h3 class="m-0 font-mincho text-[clamp(26px,3vw,34px)] leading-[1.5] font-medium tracking-[.1em]">{c.name}</h3>
                <p class="m-0 text-sm leading-[1.9] text-bl-body font-light">{c.lead}</p>
              </div>
            </div>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
              <div class="bg-bl-card rounded p-7 flex flex-col gap-3 border-t-[3px] border-bl-orange">
                <span class="text-xs font-bold tracking-[.16em] text-bl-orange">困っていたこと</span>
                <p class="m-0 text-sm leading-loose text-bl-body">{c.problem}</p>
              </div>
              <div class="bg-bl-card rounded p-7 flex flex-col gap-3 border-t-[3px] border-bl-blue">
                <span class="text-xs font-bold tracking-[.16em] text-bl-blue">作ったもの</span>
                <ul class="m-0 p-0 list-none flex flex-col gap-2">
                  {c.made.map((m) => <li class={dotItem}><span class={dot}></span><span>{m}</span></li>)}
                </ul>
                {!c.voice && <span class="mt-auto pt-3.5 border-t border-bl-line text-xs text-bl-sub">{c.period}</span>}
              </div>
              {c.voice && (
                <div class="bg-bl-orange text-white rounded p-7 flex flex-col gap-3">
                  <span class="text-xs font-bold tracking-[.16em] text-[#FFE6DC]">いただいた声</span>
                  <p class="m-0 font-mincho text-[19px] leading-[1.8] font-medium">
                    {c.voice.lines.map((l, j) => <>{j > 0 && <br />}{l}</>)}
                  </p>
                  <span class="text-xs text-[#FFE6DC]">{c.voice.from}</span>
                  <span class="mt-auto pt-3.5 border-t border-white/45 text-xs">{c.period}</span>
                </div>
              )}
            </div>
            <!-- 横にすべらせて見る画像の並び -->
            <div class="nosb flex gap-5 overflow-x-auto pb-3 snap-x snap-mandatory">
              {c.gallery.map((g) => (
                <figure class="m-0 shrink-0 w-[min(260px,70vw)] flex flex-col gap-2.5 snap-start">
                  <img src={g.src} alt={g.cap} loading="lazy" class:list={[tallImg, c.alt ? 'bg-[#EADFCF]' : 'bg-[#F2E9DC]']} />
                  <figcaption class="text-xs text-bl-sub">{g.cap}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      ))}

      <!-- CASE 04・05 -->
      <section class="py-[120px] px-[clamp(24px,5vw,72px)] bg-bl-cream2">
        <div class="max-w-[1080px] mx-auto grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-x-12 gap-y-16">
          <div id="daijobu" class="flex flex-col gap-7 scroll-mt-6">
            <div class="flex gap-5 items-start pt-8 border-t-2 border-bl-blue">
              <span class="font-garamond text-[56px] leading-[.85] text-bl-orange">04</span>
              <div class="flex flex-col gap-2">
                <span class="text-xs font-medium tracking-[.2em] text-bl-blue">CASE 04・府中の個人事業主の集まり</span>
                <h3 class="m-0 font-mincho text-[26px] leading-[1.5] font-medium tracking-[.1em]">ダイ・JO部</h3>
              </div>
            </div>
            <p class="m-0 text-sm leading-[1.9] text-bl-body font-light">府中・府中近郊の個人事業主がつながる集まりです（2026年10月発足）。</p>
            <div class="flex flex-col border-t border-bl-ink">
              <div class="flex flex-wrap gap-x-5 gap-y-1 py-4 border-b border-bl-line2">
                <span class="flex-[0_0_100px] text-xs font-bold text-bl-orange">困っていたこと</span>
                <span class="flex-[1_1_220px] text-[13px] leading-[1.9]">メンバーのお仕事やイベントの情報を、ひとつの場所にまとめたい。</span>
              </div>
              <div class="flex flex-wrap gap-x-5 gap-y-1 py-4 border-b border-bl-line2">
                <span class="flex-[0_0_100px] text-xs font-bold text-bl-blue">作ったもの</span>
                <span class="flex-[1_1_220px] text-[13px] leading-[1.9]">メンバー専用のLINE公式アカウント（リッチメニュー左右2つ）<br />メンバー紹介ページ・イベントのページ</span>
              </div>
              <div class="flex flex-wrap gap-x-5 gap-y-1 py-4 border-b border-bl-line2">
                <span class="flex-[0_0_100px] text-xs font-bold text-bl-sub">期間</span>
                <span class="flex-[1_1_220px] text-[13px] leading-[1.9]">約1週間（2026年10月）</span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <figure class="m-0 flex flex-col gap-2">
                <img src="/images/works/phone-daijobu.jpg" alt="スマホで見たところ" loading="lazy" class={`${tallImg} bg-[#EADFCF]`} />
                <figcaption class="text-xs text-bl-sub">スマホで見たところ</figcaption>
              </figure>
              <figure class="m-0 flex flex-col gap-2">
                <img src="/images/works/daijobu-richmenu.jpg" alt="リッチメニュー" loading="lazy" class={`${tallImg} bg-[#EADFCF]`} />
                <figcaption class="text-xs text-bl-sub">リッチメニュー</figcaption>
              </figure>
            </div>
          </div>
          <div id="bloomlink" class="flex flex-col gap-7 scroll-mt-6">
            <div class="flex gap-5 items-start pt-8 border-t-2 border-bl-blue">
              <span class="font-garamond text-[56px] leading-[.85] text-bl-orange">05</span>
              <div class="flex flex-col gap-2">
                <span class="text-xs font-medium tracking-[.2em] text-bl-blue">CASE 05・LINE公式アカウント・Lステップ構築サポート</span>
                <h3 class="m-0 font-mincho text-[26px] leading-[1.5] font-medium tracking-[.1em]">Bloom Link（自社）</h3>
              </div>
            </div>
            <p class="m-0 text-sm leading-[1.9] text-bl-body font-light">ロゴから公式サイト、LINEの中身まで、ブランド全体をそろえて作りました。</p>
            <div class="grid grid-cols-2 gap-4">
              <figure class="m-0 flex flex-col gap-2">
                <img src="/images/works/bloomlink-logo.jpg" alt="ロゴデザイン" loading="lazy" class={`${tallImg} bg-[#EADFCF]`} />
                <figcaption class="text-xs text-bl-sub">ロゴデザイン</figcaption>
              </figure>
              <figure class="m-0 flex flex-col gap-2">
                <img src="/images/works/bloomlink-richmenu.jpg" alt="リッチメニュー" loading="lazy" class={`${tallImg} bg-[#EADFCF]`} />
                <figcaption class="text-xs text-bl-sub">リッチメニュー</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <!-- デザイン見本 -->
      <section class="py-24 md:py-[140px] px-[clamp(24px,5vw,72px)] bg-bl-blue text-white relative overflow-hidden">
        <span class="absolute -right-[90px] -top-[90px] w-[260px] h-[260px] rounded-full bg-bl-orange"></span>
        <div class="max-w-[1080px] mx-auto flex flex-col gap-14 relative">
          <div class="flex flex-col gap-3">
            <span class="font-garamond italic text-[17px] tracking-[.12em] text-[#FBE3D9]">Design samples</span>
            <h2 class={h2Cls}>デザイン見本</h2>
            <p class="m-0 text-sm font-light">落ち着いた雰囲気だけでなく、こんなテイストも作れます</p>
          </div>
          <div class="bg-bl-card text-bl-ink rounded p-[clamp(24px,4vw,40px)] flex flex-wrap gap-x-12 gap-y-8 items-center">
            <div class="flex-[1_1_320px] grid grid-cols-2 gap-4">
              <img src="/images/works/phone-ru.jpg" alt="花屋の学び（ルー）スマホで見たところ" loading="lazy" class={`${tallImg} bg-[#F2E9DC]`} />
              <img src="/images/works/sample-ru-richmenu.jpg" alt="花屋の学び（ルー）リッチメニュー" loading="lazy" class={`${tallImg} bg-[#F2E9DC]`} />
            </div>
            <div class="flex-[1_1_300px] flex flex-col gap-3.5">
              <h3 class="m-0 font-mincho text-2xl font-medium tracking-[.08em] text-bl-blue">花屋の学び（ルー）</h3>
              <p class="m-0 text-sm leading-[2.1] text-bl-body">花屋をめざす方へ向けたLINE。無料プレゼントを大きく見せて、教科書・質問・相談の3つに分けました。写真の色をそろえて、落ち着いた雰囲気に。</p>
            </div>
          </div>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-6">
            <div class="flex flex-col gap-3.5">
              <img src="/images/works/sample-cafe-richmenu.jpg" alt="カフェ向け リッチメニュー見本" loading="lazy" class="block w-full aspect-[3/2] object-cover rounded bg-bl-card" />
              <h3 class="m-0 font-mincho text-xl font-medium">カフェ</h3>
              <p class="m-0 text-[13px] leading-[1.9] font-light">朝の光とやわらかい線で、ゆっくり過ごせる時間を。</p>
            </div>
