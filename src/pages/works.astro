---
import '../styles/global.css';

const LINE_URL = 'https://lin.ee/w7c1g5d';

// トップページと同じヘッダーナビ（別ページなので /#... で戻れるようにする）
const nav = [
  { label: 'Bloom Linkとは', href: '/#about' },
  { label: 'できること', href: '/#service' },
  { label: '選ばれる理由', href: '/#reason' },
  { label: '料金プラン', href: '/#price' },
  { label: '制作事例', href: '/#works' },
  { label: '作品集', href: '/works/' },
  { label: 'お問い合わせ', href: '/#contact' },
];

// セクション1：制作事例
// どの事例も「どんなお店・困っていたこと・作ったもの・いただいた声・期間」の同じ形でそろえる
// left … 左の列の画像（案件ごとに中身が違う。null なら出さない）
//   shadow: false の画像には影を付けない（phone-* は画像内に影があるため）
// voice が空の事例は「いただいた声」を出さない
const cases = [
  {
    id: 'rosawood',
    left: {
      src: '/images/works/rosawood-message.jpg',
      alt: 'ROSA WOOD リッチメッセージ',
      maxW: 'max-w-[380px]',
      shadow: true,
      caption: 'リッチメッセージ（トークに届く読みもの）',
    },
    name: 'ROSA WOOD',
    industry: 'アロマテラピーサロン',
    desc: 'アロマの施術と、暮らしを楽しむ教室をしているサロンです。',
    trouble: 'LINEを「予約を取るだけの場所」にしたくない。オーナーさんの人柄や暮らしを知ってもらい、ファンになってもらいたい。',
    made: ['リッチメニュー6区画（アロマってなに？／暮らし／施術メニュー／お客様の声・Q&A／教室／ご予約）', 'めくって読めるカード16枚', '施術メニューのページ'],
    voice: ['予約を初めてスマホからできました。', '綺麗になった'],
    period: '約3か月（2026年6月〜9月）',
    richmenu: { src: '/images/works/rosawood-richmenu.jpg', alt: 'ROSA WOOD リッチメニュー' },
    cards: [
      { src: '/images/works/rosawood-card-aroma.jpg', alt: 'ROSA WOODのアロマ カード', caption: 'ROSA WOODのアロマ' },
      { src: '/images/works/rosawood-card-voice.jpg', alt: 'お客様の声 カード', caption: 'お客様の声' },
    ],
  },
  {
    id: 'runaya',
    left: {
      src: '/images/works/phone-runaya.jpg',
      alt: 'るなや LINE画面',
      maxW: 'max-w-[400px]',
      // スマホ画面は縦長なので、PCでは右側（リッチメニュー＋カード）の高さに収まるよう幅を絞る
      imgMaxW: 'max-w-[400px] md:max-w-[300px]',
      shadow: false,
      caption: null,
    },
    name: 'るなや',
    industry: '飲食店（東京・府中）',
    desc: '毎日日替わりのおうちご飯とお酒のお店です（17席・おひとりで営業）。',
    trouble: '予約がDM・電話・口頭でばらばらに入り、見落としそうになる。「今日やってますか？」の問い合わせにも、営業中に答えていた。',
    made: ['お店専用の予約システム（月額0円）：満席で自動停止／お店のLINEにお知らせ／お客さまに予約の控え', 'お客様一覧（来店回数・アンケート・お店のメモ）', '本日の営業状況（ボタン1つで切りかえ）', '「るなやとは」ページ・ポイントカード'],
    voice: ['使いやすい'],
    period: '約3か月（2026年7月〜10月）',
    richmenu: { src: '/images/runaya-richmenu-2026-10.webp', alt: 'るなや リッチメニュー' },
    cards: [
      { src: '/images/runaya-card-hours-2026-10.webp', alt: 'るなや 営業時間カード', caption: '営業時間' },
      { src: '/images/runaya-card-point-2026-10.webp', alt: 'るなや ポイントカード', caption: 'ポイントカード' },
      { src: '/images/runaya-eigyo-2026-10.png', alt: 'るなや 本日の営業状況（実際の画面）', caption: '本日の営業状況（実際の画面）' },
    ],
  },
  {
    id: 'yugon',
    left: {
      src: '/images/works/phone-yugon.jpg',
      alt: 'ゆうごんさん LINE画面',
      maxW: 'max-w-[400px]',
      imgMaxW: 'max-w-[300px] md:max-w-[260px]',
      shadow: false,
      caption: null,
    },
    name: 'ゆうごんさん',
    industry: '夫婦円満カウンセラー',
    desc: '生まれた日から本来の自分を読み解く、夫婦のためのカウンセリングです。',
    trouble: 'いきなり「相談しませんか？」では、申し込みのハードルが高い。まず気軽に、自分の今の状態に気づいてもらう入り口がほしい。',
    made: ['LINE公式アカウントのリニューアル（リッチメニュー4区画）', '違和感レベルチェック（5問に答えると点数とレベルが出る）', 'プロフィール・ご相談の流れのページ'],
    voice: [],
    period: '約3週間（2026年9月）',
    richmenu: { src: '/images/works/yugon-richmenu.jpg', alt: 'ゆうごんさん リッチメニュー' },
    cards: [
      { src: '/images/works/yugon-check.jpg', alt: '違和感レベルチェック', caption: '違和感レベルチェック' },
    ],
  },
  {
    id: 'daijobu',
    left: {
      src: '/images/works/phone-daijobu.jpg',
      alt: 'ダイ・JO部 LINE画面',
      maxW: 'max-w-[400px]',
      imgMaxW: 'max-w-[260px]',
      shadow: true,
      caption: 'スマホで見たところ',
    },
    name: 'ダイ・JO部',
    industry: '府中の個人事業主の集まり',
    desc: '府中・府中近郊の個人事業主がつながる集まりです（2026年10月発足）。',
    trouble: 'メンバーのお仕事やイベントの情報を、ひとつの場所にまとめたい。',
    made: ['メンバー専用のLINE公式アカウント（リッチメニュー左右2つ）', 'メンバー紹介ページ・イベントのページ'],
    voice: [],
    period: '約1週間（2026年10月）',
    richmenu: { src: '/images/works/daijobu-richmenu.jpg', alt: 'ダイ・JO部 リッチメニュー' },
    cards: [],
  },
  {
    id: 'bloomlink',
    left: {
      src: '/images/works/bloomlink-logo.jpg',
      alt: 'Bloom Link ロゴデザイン',
      maxW: 'max-w-[400px]',
      shadow: true,
      caption: 'ロゴデザイン',
    },
    name: 'Bloom Link（自社）',
    industry: 'LINE公式アカウント・Lステップ構築サポート',
    desc: 'ロゴから公式サイト、LINEの中身まで、ブランド全体をそろえて作りました。',
    trouble: null,
    made: [],
    voice: [],
    period: null,
    richmenu: { src: '/images/works/bloomlink-richmenu.jpg', alt: 'Bloom Link リッチメニュー' },
    cards: [],
  },
];

// セクション2：デザイン見本
// phone があるものは、スマホで見たところ＋リッチメニューを横に並べて大きく見せる
const samples = [
  {
    src: '/images/works/sample-ru-richmenu.jpg',
    alt: '花屋の学び（ルー）リッチメニュー',
    phone: { src: '/images/works/phone-ru.jpg', alt: '花屋の学び（ルー）スマホで見たところ' },
    title: '花屋の学び（ルー）',
    desc: '花屋をめざす方へ向けたLINE。無料プレゼントを大きく見せて、教科書・質問・相談の3つに分けました。写真の色をそろえて、落ち着いた雰囲気に。',
  },
  {
    src: '/images/works/sample-cafe-richmenu.jpg',
    alt: 'カフェ向け リッチメニュー見本',
    title: 'カフェ',
    desc: '朝の光とやわらかい線で、ゆっくり過ごせる時間を。',
  },
  {
    src: '/images/works/sample-bar-richmenu.jpg',
    alt: 'BAR向け リッチメニュー見本',
    title: 'BAR',
    desc: '同じ飲食店でも、夜のお店は色も線もがらりと変わります。',
  },
];

// セクション3：バナー・サムネイル
const banners = [
  { src: '/images/works/note-thumbnail-1.jpg', alt: 'note記事サムネイル 1', caption: 'note記事サムネイル' },
  { src: '/images/works/note-thumbnail-2.jpg', alt: 'note記事サムネイル 2', caption: 'note記事サムネイル' },
];

const imgShadow = 'shadow-[0_8px_24px_rgba(53,94,72,0.08)]';
const dtClass = 'inline-block text-xs tracking-[0.15em] text-sage bg-[#BFD4C7]/50 rounded-full px-3 py-0.5 mb-2';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>作品集｜Bloom Link</title>
    <meta
      name="description"
      content="Bloom Linkがこれまでにつくった LINE公式アカウントとお店専用のしくみの作品集。困っていたこと・作ったもの・いただいた声を、お店ごとにご紹介します。"
    />
  </head>
  <body class="bg-cream text-[#3f3a37] font-sans antialiased">
    <!-- ヘッダー（トップページと同じ） -->
    <header class="sticky top-0 z-50 bg-cream/90 backdrop-blur border-b border-sage/10">
      <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
        <a href="/" class="text-lg tracking-widest text-sage font-semibold">Bloom Link</a>
        <nav class="hidden md:flex items-center gap-8 text-sm text-[#5c5450]">
          {nav.map((item) => (
            <a href={item.href} class="hover:text-sage transition-colors">{item.label}</a>
          ))}
        </nav>
        <a
          href="/#contact"
          class="text-xs md:text-sm text-white rounded-full px-5 py-2 bg-gradient-to-b from-[#e2aab6] to-[#cf8b98] shadow-[inset_0_1px_0_rgba(255,255,255,0.3),0_6px_16px_rgba(180,120,132,0.18)] hover:from-[#d99aa8] hover:to-[#bf7a89] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_8px_20px_rgba(180,120,132,0.24)] hover:-translate-y-0.5 transition-all duration-200 whitespace-nowrap"
        >
          無料相談してみる
        </a>
      </div>
    </header>

    <main>
      <!-- ■ 冒頭 -->
      <section class="bg-cream">
        <div class="max-w-5xl mx-auto px-6 pt-20 md:pt-28 pb-8 md:pb-10">
          <p class="text-xs tracking-[0.25em] text-sage/60 mb-4">WORKS</p>
          <h1 class="text-2xl md:text-3xl font-medium text-sage leading-snug mb-8">作品集</h1>
          <p class="ja-text text-[#5c5450] leading-[2] mb-8 max-w-3xl">
            これまでにつくった LINE公式アカウントと、お店専用のしくみです。<br />
            どれも「そのお店の困りごと」から考えて、一つひとつ作っています。
          </p>
          <ul class="space-y-2 text-sm text-[#6B6B64] leading-relaxed max-w-3xl">
            <li>・リッチメニュー … LINEを開いたとき、画面の下半分にいつも出ているメニュー</li>
            <li>・カードタイプメッセージ … トークに届く、横にスワイプして見られるカード</li>
            <li>・リッチメッセージ … トークに届く、1枚の大きな画像</li>
          </ul>
        </div>
      </section>

      <!-- ■ セクション1：制作事例（背景を薄い緑にして、白いカードを浮かせる） -->
      <section class="bg-[#BFD4C7]/25">
        <div class="max-w-5xl mx-auto px-4 md:px-6 pt-14 md:pt-20 pb-16 md:pb-24">
          <div class="mb-10 md:mb-14 px-2 md:px-0">
            <h2 class="text-xl md:text-2xl font-medium text-sage leading-snug mb-2">制作事例</h2>
            <p class="text-sm text-[#6B6B64]">実際のお店で使われているLINEです</p>
            <p class="mt-4"><a href="/dekiru/" class="text-sm text-sage underline underline-offset-4 decoration-sage/30 hover:decoration-sage transition-colors">できることを見る →</a></p>
          </div>

          <div class="space-y-10 md:space-y-14">
            {cases.map((c) => (
              <article id={c.id} class="scroll-mt-24 bg-white rounded-3xl px-5 py-6 md:px-12 md:py-12 shadow-[0_10px_30px_rgba(53,94,72,0.08)]">
                <!-- 店名の帯（ここでメリハリをつける） -->
                <div class="rounded-xl bg-gradient-to-b from-[#e7aeb8] to-[#DFA2AE] text-white text-center px-4 py-3 md:py-4 mb-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.35)]">
                  <h3 class="text-lg md:text-xl font-medium tracking-wider leading-snug">{c.name}</h3>
                </div>
                <p class="text-sm text-[#6B6B64] text-center mb-8 md:mb-10">{c.industry}</p>

                <div class="grid gap-y-8 md:grid-cols-[400px_1fr] md:gap-x-12 md:gap-y-0">
                <!-- 1行目・左：説明 → 困っていたこと・作ったもの・声・期間 -->
                <div class={`${c.left?.maxW ?? 'max-w-[400px]'} md:col-start-1 md:row-start-1 md:mb-[30px]`}>
                  <p class="ja-text text-[#5c5450] leading-[2]">{c.desc}</p>
                  {c.trouble && (
                    <dl class="mt-6 space-y-5">
                      <div>
                        <dt class={dtClass}>困っていたこと</dt>
                        <dd class="ja-text text-sm text-[#5c5450] leading-[1.9]">{c.trouble}</dd>
                      </div>
                      {c.made.length > 0 && (
                        <div>
                          <dt class={dtClass}>作ったもの</dt>
                          <dd>
                            <ul class="space-y-1.5">
                              {c.made.map((m) => (
                                <li class="flex gap-2.5 ja-text text-sm text-[#5c5450] leading-[1.9]">
                                  <span aria-hidden="true" class="mt-[0.8em] h-1.5 w-1.5 shrink-0 rounded-full bg-[#DFA2AE]"></span>
                                  <span>{m}</span>
                                </li>
                              ))}
                            </ul>
                          </dd>
                        </div>
                      )}
                      {c.voice.length > 0 && (
                        <div>
                          <dt class={dtClass}>いただいた声</dt>
                          <dd class="space-y-1.5">
                            {c.voice.map((v) => (
                              <p class="ja-text text-sm text-sage leading-[1.9] bg-[#E8B8BE]/15 rounded-xl px-4 py-2">「{v.replace(/。$/, '')}」</p>
                            ))}
                          </dd>
                        </div>
                      )}
                      {c.period && (
                        <div>
                          <dt class={dtClass}>期間</dt>
                          <dd class="ja-text text-sm text-[#5c5450] leading-[1.9]">{c.period}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                </div>

                <!-- 1行目・右：空 -->
                <div class="hidden md:block md:col-start-2 md:row-start-1"></div>

                <!-- 2行目・左：画像（案件ごとに中身が違う1枚） -->
                <div class="md:col-start-1 md:row-start-2">
                  {c.left && (
                    <figure class={c.left.imgMaxW ?? c.left.maxW}>
                      <img
                        src={c.left.src}
                        alt={c.left.alt}
                        loading="lazy"
                        class={`block w-full h-auto rounded-2xl ${c.left.shadow ? imgShadow : ''}`}
                      />
                      {c.left.caption && (
                        <figcaption class="text-xs text-[#6B6B64] text-center mt-3">{c.left.caption}</figcaption>
                      )}
                    </figure>
                  )}
                </div>

                <!-- 2行目・右：リッチメニュー ＋ カード -->
                <div class="md:col-start-2 md:row-start-2">
                  <!-- リッチメニュー -->
                  <figure class="mb-8">
                    <img
                      src={c.richmenu.src}
                      alt={c.richmenu.alt}
                      loading="lazy"
                      class={`block w-full h-auto rounded-2xl ${imgShadow}`}
                    />
                    <figcaption class="text-xs text-[#6B6B64] text-center mt-3">リッチメニュー</figcaption>
                  </figure>

                  <!-- カード（横2列・スマホでも2列） -->
                  {c.cards.length > 0 && (
                    <div class="grid grid-cols-2 gap-4 md:gap-6">
                      {c.cards.map((card) => (
                        <figure>
                          <img
                            src={card.src}
                            alt={card.alt}
                            loading="lazy"
                            class={`block w-full h-auto rounded-2xl ${imgShadow}`}
                          />
                          <figcaption class="text-xs text-[#6B6B64] text-center mt-3">{card.caption}</figcaption>
                        </figure>
                      ))}
                    </div>
                  )}
                </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ■ セクション2：デザイン見本（制作事例の緑と交互にするため、こちらは薄いピンク） -->
      <section class="bg-[#E8B8BE]/[0.14]">
        <div class="max-w-5xl mx-auto px-6 py-16 md:py-24">
          <div class="mb-12 md:mb-16">
            <h2 class="text-xl md:text-2xl font-medium text-sage leading-snug mb-2">デザイン見本</h2>
            <p class="text-sm text-[#6B6B64]">落ち着いた雰囲気だけでなく、こんなテイストも作れます</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12">
            {samples.map((s) => (
              <div class={s.phone ? 'md:col-span-2' : ''}>
                {s.phone ? (
                  <div class="grid grid-cols-[34%_1fr] gap-4 md:gap-8 items-end">
                    <img
                      src={s.phone.src}
                      alt={s.phone.alt}
                      loading="lazy"
                      class={`block w-full h-auto rounded-2xl ${imgShadow}`}
                    />
                    <img
                      src={s.src}
                      alt={s.alt}
                      loading="lazy"
                      class={`block w-full h-auto rounded-2xl ${imgShadow}`}
                    />
                  </div>
                ) : (
                  <img
                    src={s.src}
                    alt={s.alt}
                    loading="lazy"
                    class={`block w-full h-auto rounded-2xl ${imgShadow}`}
                  />
                )}
                <h3 class="text-base md:text-lg font-medium text-sage mt-5 mb-2">{s.title}</h3>
                <p class="ja-text text-sm text-[#5c5450] leading-[1.9]">{s.desc}</p>
              </div>
            ))}
          </div>

          <p class="ja-text text-sm text-[#6B6B64] leading-[1.9] mt-12">
            同じ「飲食店」でも、お店の時間帯やお客さまに合わせて作り分けます。
          </p>
        </div>
      </section>

      <!-- ■ セクション3：バナー・サムネイル -->
      <section class="bg-cream">
        <div class="max-w-5xl mx-auto px-6 py-16 md:py-24">
          <div class="mb-12 md:mb-16">
            <h2 class="text-xl md:text-2xl font-medium text-sage leading-snug mb-2">バナー・サムネイル</h2>
            <p class="text-sm text-[#6B6B64]">LINE以外のデザインも作っています</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12">
            {banners.map((b) => (
              <figure>
                <img
                  src={b.src}
                  alt={b.alt}
                  loading="lazy"
                  class={`block w-full h-auto rounded-2xl ${imgShadow}`}
                />
                <figcaption class="text-xs text-[#6B6B64] text-center mt-3">{b.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- ■ 最後：お問い合わせへの導線 -->
      <section class="bg-cream">
        <div class="max-w-3xl mx-auto px-6 pb-24 md:pb-32 pt-4 text-center">
          <h2 class="text-xl md:text-2xl font-medium text-sage leading-snug mb-5">うちのお店だと、どうなる？</h2>
          <p class="ja-text text-[#5c5450] leading-[2] mb-10">
            ご相談は無料です。無理な勧誘はしません。
          </p>
          <div class="flex flex-col md:flex-row items-center justify-center gap-4">
            <a
              href={LINE_URL}
              target="_blank"
              rel="noopener"
              class="inline-block w-full max-w-xs md:w-auto text-white rounded-full px-9 py-3.5 text-sm font-medium bg-gradient-to-b from-[#06C755] to-[#04b14a] shadow-[inset_0_1px_0_rgba(255,255,255,0.3),0_6px_18px_rgba(4,140,58,0.16)] hover:from-[#05b94e] hover:to-[#039e42] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_8px_22px_rgba(4,140,58,0.22)] hover:-translate-y-0.5 transition-all duration-200"
            >
              LINEで相談する
            </a>
            <a
              href="/#works"
              class="inline-block w-full max-w-xs md:w-auto text-sage rounded-full px-9 py-3.5 text-sm font-medium border border-sage/30 hover:bg-sage/5 hover:-translate-y-0.5 transition-all duration-200"
            >
              閉じる
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- フッター（トップページと同じ） -->
    <footer class="bg-sage text-cream">
      <div class="max-w-6xl mx-auto px-6 py-14 md:py-16 text-center">
        <p class="text-xl tracking-[0.15em] mb-7">Bloom Link</p>
        <p class="mb-6 text-2xl md:text-3xl leading-relaxed">
          つながりを育て、<br />
          未来を咲かせる。
        </p>
