---
// トップページ（2026/10 全面リニューアル）
// デザイン見本：design_handoff_toppage/toppage-design.dc.html
// 文章は見本のまま。セクションごとに src/components/top/ に分けている。
import '../styles/global.css';
import '../styles/top.css';
import Hero from '../components/top/Hero.astro';
import Problem from '../components/top/Problem.astro';
import ForYou from '../components/top/ForYou.astro';
import Service from '../components/top/Service.astro';
import Admin from '../components/top/Admin.astro';
import Works from '../components/top/Works.astro';
import Secretary from '../components/top/Secretary.astro';
import Price from '../components/top/Price.astro';
import FlowFaq from '../components/top/FlowFaq.astro';
import AboutMe from '../components/top/AboutMe.astro';
import Contact from '../components/top/Contact.astro';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bloom Link｜パソコンを開かずに、スマホで解決。LINE公式・Lステップ構築</title>
    <meta
      name="description"
      content="Bloom Linkは、LINE公式アカウント・Lステップの構築と、予約・スマホ秘書・顧客管理などのしくみづくりで、パソコンを開かずにスマホで回せるお店・会社をつくります。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Noto+Sans+JP:wght@300;400;500;700&family=Shippori+Mincho:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bl-cream text-bl-ink font-notojp antialiased tracking-[.04em]">
    <div class="flex flex-col overflow-x-hidden">
      <Hero />
      <Problem />
      <ForYou />
      <Service />
      <Admin />
      <Works />
      <Secretary />
      <Price />
      <FlowFaq />
      <AboutMe />
      <Contact />
    </div>
  </body>
</html>
