---
// 07 スマホ秘書（Bloom Linkも毎日使っている）
import Label from './Label.astro';

const secretary = [
  '予定は、LINEに送るだけ。Googleカレンダーに入って、前の日の夜と当日の朝にお知らせが届きます',
  'レシートは写真を撮って送るだけ。AIが読み取って表に記録します',
  'メールで届く領収書も、毎朝自動で保存されます',
];
---

<section class="pb-24 md:pb-40 pt-24 md:pt-0 px-[clamp(24px,5vw,72px)]">
  <div class="max-w-[1080px] mx-auto flex gap-[clamp(48px,8vw,120px)] flex-wrap items-center">
    <div class="w-[340px] max-w-full h-[470px] rounded-t-[170px] bg-bl-blue flex items-end justify-center overflow-hidden mx-auto md:mx-0">
      <div class="w-[210px] h-[400px] rounded-t-[28px] bg-bl-cream pt-2 px-2">
        <!-- 早苗さんのサナロボが動いているところ（予定ロボの動画から・2026/11/4。レシートはぼかし済み・音なし・くり返し） -->
        <video
          src="/images/top/secretary-sanarobo.mp4"
          poster="/images/top/secretary-sanarobo-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="サナロボのLINE画面：予定を打って送ると、カレンダーに入ったとお返事が届く（動画）"
          class="block w-full h-full rounded-t-[20px] object-cover object-top bg-[#8FACD4]"
        ></video>
      </div>
    </div>
    <div class="flex-1 min-w-[min(300px,100%)] flex flex-col gap-8">
      <Label text="06 — Our daily use" />
      <h2 class="m-0 font-mincho font-medium text-[24px] md:text-[30px] leading-[1.9] tracking-[.12em]">
        Bloom Linkも、<br />毎日この秘書を使っています。
      </h2>
      <ul class="m-0 p-0 list-none flex flex-col border-t border-bl-line">
        {secretary.map((s) => (
          <li class="py-[18px] border-b border-bl-line text-sm leading-loose font-light">{s}</li>
        ))}
      </ul>
      <p class="m-0 font-mincho text-lg font-medium tracking-[.08em] text-bl-orange">パソコンを開くのは、本当に必要なときだけになりました。</p>
    </div>
  </div>
</section>
