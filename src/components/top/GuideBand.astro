---
// 10.8 無料ガイド（相談の上に置く帯）2026/11/4
// 表紙：claud教室/無料ガイド/はじめてでも安心 公式LINEガイド.png を縮小したもの
import Label from './Label.astro';
---

<section id="free-guide" class="pt-20 md:pt-28 pb-24 md:pb-32 px-[clamp(24px,5vw,72px)]">
  <div class="max-w-[960px] mx-auto bg-bl-card border border-bl-line rounded-[28px] p-8 md:p-12 grid grid-cols-1 md:grid-cols-[220px_minmax(0,1fr)] gap-8 md:gap-12 items-center">
    <img
      src="/images/top/guide-cover.jpg"
      alt="無料ガイド「はじめてでも大丈夫。公式LINEのつくりかた」の表紙"
      width="600"
      height="800"
      loading="lazy"
      class="block w-[180px] md:w-full mx-auto rounded-xl shadow-[0_10px_24px_rgba(34,32,30,.12)]"
    />
    <div class="flex flex-col gap-5 text-center md:text-left items-center md:items-start">
      <Label text="Free guide" />
      <h2 class="m-0 font-mincho font-medium text-[22px] md:text-[28px] leading-[1.8] tracking-[.12em]">
        まずは自分で<br class="md:hidden" />作ってみたい方へ
      </h2>
      <p class="m-0 text-sm leading-[2.1] text-bl-body font-light">
        LINE公式アカウントのつくりかたを、スマホの画面つきでまとめました。<br class="hidden md:inline" />
        スマホだけで、だいたい15分。途中で止まったら、そのままご相談ください。
      </p>
      <a
        href="/bloom-link-free-guide.pdf"
        target="_blank"
        rel="noopener"
        class="mt-1 bg-bl-orange hover:bg-bl-ink transition-colors text-white no-underline text-[15px] font-bold tracking-[.14em] py-4 px-10 rounded-full"
      >
        無料ガイドを見る
      </a>
    </div>
  </div>
</section>
