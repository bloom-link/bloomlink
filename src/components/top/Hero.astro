---
// 01 ヒーロー
---

<header class="relative overflow-hidden flex flex-col min-h-[640px] md:min-h-[760px] pt-8 px-[clamp(24px,5vw,72px)]">
  <div class="flex justify-between items-center gap-6 flex-wrap pb-5 border-b border-bl-line">
    <span class="text-[13px] font-medium tracking-[.42em] text-bl-ink">BLOOM LINK</span>
    <nav class="flex gap-6 md:gap-10 whitespace-nowrap text-xs tracking-[.14em]">
      <a href="/dekiru/" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">できること</a>
      <a href="#price" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">料金</a>
      <a href="#works" class="text-bl-ink no-underline hover:text-bl-orange transition-colors">事例</a>
    </nav>
  </div>

  <div class="flex-1 flex justify-center items-end gap-[clamp(40px,8vw,120px)] flex-wrap pt-14">
    <h1 class="hero-drop tate order-1 md:order-none m-0 self-center font-mincho font-medium text-[26px] md:text-[46px] leading-[1.9] tracking-[.08em] md:tracking-[.16em] md:h-[600px] text-center md:text-left">
      パソコンを開かずに、<br /><span class="text-bl-orange">スマホで解決。</span>
    </h1>

    <div class="relative order-3 md:order-none">
      <div class="relative overflow-hidden bg-bl-orange w-[min(420px,calc(100vw-96px))] aspect-[420/580] rounded-t-[999px]">
        <img
          src="/images/top/hand-phone_white.png"
          alt="Bloom Linkのスマホを持つ手"
          class="hero-float absolute left-1/2 -translate-x-[44%] top-[12.4%] h-[93%] max-w-none"
        />
      </div>
      <!-- 青い丸：さわる（つかんで動かす）と動いて、はなすと元の場所にぽよんと戻る -->
      <div data-hero-ball class="hero-ball absolute -left-6 md:-left-11 top-24 w-[min(88px,21vw)] h-[min(88px,21vw)]" aria-hidden="true">
        <span class="hero-ball-in block w-full h-full rounded-full bg-bl-blue"></span>
      </div>
    </div>

    <div class="hero-rise flex self-center md:flex-col items-center gap-5 order-2 md:order-none w-full md:w-auto justify-center">
      <span class="h-px w-10 md:w-px md:h-14 bg-bl-ink"></span>
      <span class="tate text-sm font-medium tracking-[.24em]"><span class="text-bl-blue font-bold">LINE</span>公式・Lステップ</span>
      <span class="h-px w-10 md:w-px md:h-14 bg-bl-ink"></span>
    </div>
  </div>
</header>

<script>
  // 青い丸：指やマウスでつかんで動かせる。はなすと元の場所に戻る。軽くさわっただけでも、ぴょんと跳ねる
  const ball = document.querySelector<HTMLElement>('[data-hero-ball]');
  if (ball) {
    let sx = 0;
    let sy = 0;
    let moved = false;
    const move = (e: PointerEvent) => {
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
      ball.style.transform = `translate(${dx}px, ${dy}px)`;
    };
    const end = () => {
      ball.classList.remove('is-dragging');
      ball.style.transform = '';
      if (!moved) {
        ball.classList.remove('is-hop');
        void ball.offsetWidth; // 続けてさわっても、もう一度跳ねるように
        ball.classList.add('is-hop');
      }
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', end);
      window.removeEventListener('pointercancel', end);
    };
    ball.addEventListener('pointerdown', (e) => {
      sx = e.clientX;
      sy = e.clientY;
      moved = false;
      ball.classList.add('is-dragging');
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', end);
      window.addEventListener('pointercancel', end);
    });
  }
</script>
