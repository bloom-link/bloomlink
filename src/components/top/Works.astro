---
// 06 事例（横スライダー）
import Label from './Label.astro';

const works = [
  {
    cat: '飲食店（東京・府中）',
    name: 'るなや',
    img: '/images/works/works-runaya.jpg',
    alt: 'るなやの店内の写真とリッチメニュー',
    fit: 'cover',
    sys: '予約・受付システム／LINE公式アカウント',
    items: ['ワンオペのお店の、予約の見落としを減らしました', '予約が入ると、すぐにお店のLINEに通知が届きます', '「予約する」「本日の営業状況」「アクセス」が、ボタンひと押しで開けます'],
    link: '→ 制作ストーリーを見る',
    href: '/story/runaya',
  },
  {
    cat: 'アロマテラピーサロン',
    name: 'ROSA WOOD',
    img: '/images/rosawood.jpg',
    alt: 'ROSA WOODのアロマのしつらえ',
    fit: 'cover',
    sys: 'LINE公式アカウント',
    items: ['オーナーさんの声：「誰が何に関心があるのかが、わかるようになりました」', 'お客さまの声：「見やすくなった」', '教室の説明をLINEに入れたことで、講座や教室を以前より積極的に開催されるようになりました'],
    link: '→ 制作ストーリーを見る',
    href: '/story/rosa-wood',
  },
  {
    cat: '夫婦円満カウンセラー',
    name: 'ゆうごんさん',
    img: '/images/works/works-yugon.jpg',
    alt: 'ゆうごんさんのLINE公式アカウントの画面',
    fit: 'cover',
    sys: 'お客さま向けのセルフチェック',
    items: ['お客さまが質問に答えると、結果がLINEで届くチェックを作りました'],
    link: '→ 実例を見る',
    href: '/works/',
  },
  {
    cat: '府中の個人事業主の集まり',
    name: 'ダイ・JO部',
    img: '/images/works/works-daijobu.jpg',
    alt: 'ダイ・JO部のロゴとLINEの画面',
    fit: 'cover',
    sys: 'メンバー専用のLINE（連絡の窓口）',
    items: ['メンバーへのお知らせや案内を、1つのLINEにまとめました'],
    link: '→ 実例を見る',
    href: '/works/',
  },
];
---

<section id="works" class="py-24 md:py-40 px-[clamp(24px,5vw,72px)] bg-bl-cream2">
  <div class="max-w-[1080px] mx-auto flex flex-col gap-12 md:gap-[72px]">
    <div class="flex justify-between items-end gap-6 flex-wrap pb-7 border-b border-bl-ink">
      <div class="flex flex-col gap-4">
        <Label text="05 — Works" />
        <h2 class="m-0 font-mincho font-medium text-[24px] md:text-[34px] tracking-[.14em]">実際に使っていただいています。</h2>
      </div>
      <div class="flex gap-3">
        <button type="button" data-works-prev aria-label="前へ" class="w-[52px] h-[52px] rounded-full border-0 bg-bl-blue hover:bg-bl-orange transition-colors text-white text-lg cursor-pointer">←</button>
        <button type="button" data-works-next aria-label="次へ" class="w-[52px] h-[52px] rounded-full border-0 bg-bl-blue hover:bg-bl-orange transition-colors text-white text-lg cursor-pointer">→</button>
      </div>
    </div>

    <div
      data-works-track
      class="nosb flex gap-10 overflow-x-auto -mr-[clamp(24px,5vw,72px)] pr-[clamp(24px,5vw,72px)]"
    >
      {works.map((w) => (
        <article data-works-card class="flex-[0_0_min(440px,82vw)] flex flex-col gap-6">
          {/* LINEの画面は縦長なので、枠の中に丸ごと収める（contain）。写真は枠いっぱい（cover） */}
          <div class="aspect-[3/2] overflow-hidden bg-bl-card">
            <img
              src={w.img}
              alt={w.alt}
              loading="lazy"
              class:list={['block w-full h-full', w.fit === 'contain' ? 'object-contain py-4' : 'object-cover']}
            />
          </div>
          <div class="flex flex-col gap-2.5">
            <span class="text-[11px] text-bl-faint tracking-[.16em]">{w.cat}</span>
            <h3 class="m-0 font-mincho text-[26px] font-medium tracking-[.1em] text-bl-orange">{w.name}</h3>
            <span class="text-xs font-medium text-bl-blue tracking-[.04em]">使っているしくみ：{w.sys}</span>
          </div>
          <ul class="m-0 p-0 list-none flex flex-col gap-1.5">
            {w.items.map((it) => (
              <li class="text-[13px] leading-loose text-bl-body font-light">— {it}</li>
            ))}
          </ul>
          <a href={w.href} class="self-start text-xs tracking-[.14em] text-bl-ink no-underline border-b border-bl-ink pb-1 hover:text-bl-orange hover:border-bl-orange transition-colors">{w.link}</a>
        </article>
      ))}
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] border-y border-bl-ink">
      <div class="py-10 md:pr-10 flex flex-col gap-4 border-b md:border-b-0 md:border-r border-bl-line">
        <h3 class="m-0 font-mincho text-[22px] font-medium tracking-[.1em]">LINEを体験してみる</h3>
        <p class="m-0 text-[13px] leading-loose text-bl-body font-light">Lステップのデモアカウント（Pilates Studio）で、実際の使い心地を試せます。</p>
        <a href="https://line.me/ti/p/%40202lchui" target="_blank" rel="noopener" class="self-start text-xs tracking-[.14em] text-bl-ink no-underline border-b border-bl-ink pb-1 hover:text-bl-orange hover:border-bl-orange transition-colors">→ LINEを体験してみる</a>
      </div>
      <div class="py-10 md:pl-10 flex flex-col gap-4">
        <div class="flex gap-3 items-center">
          <span class="w-2.5 h-2.5 rounded-full bg-bl-blue shrink-0"></span>
          <h3 class="m-0 font-mincho text-[22px] font-medium tracking-[.1em]">工務店・会社のモニター募集中</h3>
        </div>
        <p class="m-0 text-[13px] leading-loose text-bl-body font-light">工務店や少人数の会社でも使っていただけるように、モニターを募集しています。</p>
        <a href="https://lin.ee/w7c1g5d" target="_blank" rel="noopener" class="self-start text-xs tracking-[.14em] text-bl-orange no-underline border-b border-bl-orange pb-1 hover:text-bl-ink hover:border-bl-ink transition-colors">→ LINEで相談する</a>
      </div>
    </div>
  </div>
</section>

<script>
  // 事例の並び：止まらずに、すうーっと横に流れつづける（2026/11/3）
  // ・カードを後ろにもう1組くっつけて、つなぎ目なく一周する
  // ・さわったり、マウスをのせたりしているあいだは止まる。はなすと、また流れだす
  // ・← → ボタンでも1枚ずつ動かせる
  const track = document.querySelector<HTMLElement>('[data-works-track]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('[data-works-card]'));
    const GAP = 40;
    const cardW = () => (cards[0]?.getBoundingClientRect().width ?? 440) + GAP;

    // 2組目（押すこともできる。読み上げやキーボードでは1組目だけをたどる）
    if (!reduce) {
      cards.forEach((c) => {
        const copy = c.cloneNode(true) as HTMLElement;
        // 押せないようにすると、流れてきたカードのリンクが効かなくなるので、読み上げとキーボードだけ外す
        copy.setAttribute('aria-hidden', 'true');
        copy.querySelectorAll('a').forEach((l) => l.setAttribute('tabindex', '-1'));
        copy.removeAttribute('data-works-card');
        track.appendChild(copy);
      });
    }
    // 1周の長さ＝1組ぶんの幅
    const loopW = () => cards.length * cardW();
    const wrap = (x: number) => {
      const L = loopW();
      return reduce ? x : ((x % L) + L) % L;
    };

    let pos = 0;
    let pausedUntil = 0;
    let holding = false;
    const pause = (ms: number) => { pausedUntil = Date.now() + ms; };

    const slide = (dir: number) => {
      if (!reduce) {
        // 1周のはしにいるときは、見た目が同じ場所へ先に移ってから動かす
        const x = track.scrollLeft;
        if (dir < 0 && x < cardW()) track.scrollLeft = x + loopW();
        if (dir > 0 && x >= loopW()) track.scrollLeft = x - loopW();
      }
      track.scrollBy({ left: dir * cardW(), behavior: 'smooth' });
      pause(5000);
    };
    document.querySelector('[data-works-prev]')?.addEventListener('click', () => slide(-1));
    document.querySelector('[data-works-next]')?.addEventListener('click', () => slide(1));

    if (!reduce) {
      track.addEventListener('pointerenter', () => { holding = true; });
      track.addEventListener('pointerleave', () => { holding = false; pause(1200); });
      ['pointerdown', 'touchstart', 'wheel', 'focusin'].forEach((ev) =>
        track.addEventListener(ev, () => pause(4000), { passive: true }),
      );

      let visible = false;
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; }, { threshold: 0.2 }).observe(track);

      const SPEED = 36; // 1秒に進む量（px）。大きくすると速くなる
      let last = performance.now();
      let wasRunning = false;
      const tick = (now: number) => {
        const dt = Math.min(now - last, 64) / 1000;
        last = now;
        const running = visible && !holding && Date.now() >= pausedUntil && !document.hidden;
        if (running) {
          // 止まっていたあとは、人が動かした場所から続ける
          if (!wasRunning) pos = wrap(track.scrollLeft);
          pos = wrap(pos + SPEED * dt);
          track.scrollLeft = pos;
        }
        wasRunning = running;
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
